node_modules/
dist/
build/
# The site's own route named "build" (apps/site/src/routes/build/), not an output directory.
!apps/site/src/routes/build/
.svelte-kit/
.wrangler/
*.tsbuildinfo
*.brain
*.brainl
*.brainl.age
*.sqlite
_*
__*
# Cloudflare reads `_headers` from each app's static directory, so those two are kept.
!apps/*/static/_headers
.DS_Store

# Screenshots a person looks at, regenerated on demand and never asserted on: see the site's
# `scripts/shot.mjs`. Anchored per app rather than a bare `shots/`, because the marketing site
# SERVES product shots from `apps/site/static/shots/` and a bare pattern silently excluded them.
apps/*/shots/
# AND THE ROOT ONE, because `shot.mjs` writes relative to where it was RUN, and it is run from the
# repository root as often as from an app: a per-app anchor left `/shots/` staged and ready to commit.
/shots/
packages/theme/proof.txt

# the a11y gate writes its run here
.a11y.log

# AND ONE FAKE BUILD THAT IS KEPT, because a gate's negative fixture is a tree the gate reads and
# `bundle` reads a build. `negative/bundle-missing-chunk/` is a manifest naming a chunk that is not
# beside it, which is the input the gate used to die on, and a manifest can only be read from where
# the real one lives. Nothing under it is output: no command produces it and nothing can regenerate
# it, which is the whole of what line 4 is for.
!tools/gates/negative/*/apps/*/.svelte-kit/

# A deployment's build, beside production's `build/`: `BRAINDOG_ENV=alpha` writes
# `apps/web/build-alpha/` (`apps/web/svelte.config.js`), which the Worker's alpha
# environment serves. Never committed: it is a build. The pattern is wider than
# that one name because it once also held the sample's variant builds
# (`build-busy/`, `build-cloud/`, `build-quiet/`), which the browser gates now
# get as records from `tools/gates/record.mjs`; a tree built before that still
# has them, and they are output all the same.
build-*/

# The CLI the deploy copies into the site before building it (deploy.yml, "Build the CLI for the site"); built, never committed.
apps/site/static/cli/braindog.mjs*

# Working notes, briefs and reports kept on the machine that builds BrainDog, never in the repository.
/loop/
/REPORT.md
/BUILD.md
/CLAUDE.md
/.claude/

# A gate's private word lists: words a machine guards and the repository does not publish
# (tools/gates/shell-words.mjs and clean-room.mjs read them when they are there).
tools/gates/*.local.json
