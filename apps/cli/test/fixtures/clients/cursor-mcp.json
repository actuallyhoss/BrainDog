{
  "mcpServers": {
    "server-name": {
      "command": "npx",
      "args": ["-y", "mcp-server"],
      "env": {
        "API_KEY": "value"
      }
    },
    "remote": {
      "url": "http://localhost:3000/mcp",
      "headers": {
        "X-Region": "eu"
      }
    }
  },
  "otherSetting": true
}
