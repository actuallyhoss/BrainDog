{
  "name": "braindog-cli",
  "version": "0.1.0",
  "description": "The BrainDog command line: sign in, connect your agents over MCP, deposit keys, and build packs.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://brain.dog/docs/agents/connect",
  "repository": { "type": "git", "url": "git+https://github.com/actuallyhoss/BrainDog.git", "directory": "apps/cli" },
  "bugs": { "email": "support@brain.dog" },
  "keywords": ["braindog", "mcp", "cli", "agents", "memory"],
  "bin": { "braindog": "dist/braindog.mjs" },
  "files": ["dist"],
  "engines": { "node": ">=24.13" },
  "publishConfig": { "access": "public" },
  "devDependencies": {
    "@braindog/client": "workspace:*",
    "@braindog/declare": "workspace:*",
    "@braindog/dog": "workspace:*",
    "@braindog/kernel": "workspace:*",
    "@braindog/mcp": "workspace:*",
    "@braindog/pack-live-feed": "workspace:*",
    "@braindog/ports": "workspace:*",
    "@braindog/seed": "workspace:*",
    "braindog-render": "workspace:*",
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
