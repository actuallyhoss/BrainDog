{
  "name": "@braindog/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "brain.dog \u2014 the marketing site. Prerendered, no JavaScript required to read it.",
  "scripts": {
    "build": "pnpm --filter @braindog/skin theme && vite build",
    "deploy:production": "wrangler deploy --env production",
    "dev": "vite dev",
    "lighthouse": "node scripts/lighthouse.mjs",
    "preview": "vite preview",
    "test": "node --test test/*.test.ts test/*.test.mjs scripts/*.test.mjs \"src/**/*.test.ts\"",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@braindog/skin": "workspace:*",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "braindog-render": "workspace:*",
    "lighthouse": "13.5.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.2.4",
    "wrangler": "4.157.0"
  }
}
