{
  "$schema": "../../node_modules/wrangler/config-schema.json",

  /* ===========================================================================================
     THE MARKETING SITE — THE ONLY THING HERE THAT IS ACTUALLY A SEPARATE STATIC DEPLOYMENT.

     `apps/web` ships inside the Worker version as `assets` (33 §7); this does not, because it
     answers a different hostname and has nothing to do with a record. It is three prerendered
     pages — `/`, `/pricing`, `/changelog` — built with `strict: true` so a route that quietly
     stopped prerendering fails the build rather than shipping blank (`apps/site/svelte.config.js`).

     A WORKER WITH NO CODE, WHICH IS WHY THERE IS NO `main` KEY. Static assets are served before
     any Worker code runs, so a `main` here would be a script that never executes on the happy path
     and executes on every 404 — a place for logic to accumulate in the one part of the product
     that is allowed to have none. Cloudflare Pages was the other candidate and is the wrong one:
     it is a second deployment system with its own build settings, its own preview semantics and
     its own dashboard, for a directory that `wrangler deploy` already knows how to upload. One
     tool, two configs, and `wrangler rollback` works the same way on both.

     THE SITE AND THE APP ROLL BACK INDEPENDENTLY, and that is a feature rather than an oversight:
     a marketing copy change cannot be the reason the record is unavailable, and a Durable Object
     migration cannot be the reason a price is wrong.
     =========================================================================================== */

  "name": "braindog-site",

  /* Required even with no code, and pinned to the Worker's own date for one reason: two numbers
     that mean "the platform behaviour we deployed against" should not be two numbers. */
  "compatibility_date": "2026-09-01",

  /* The site's whole job is to arrive at one address. A `workers.dev` copy is a second URL for the
     same three pages, indexable, with no canonical tag — a self-inflicted duplicate-content
     problem on the one page whose job is to be found. */
  "workers_dev": false,
  "preview_urls": false,

  "observability": { "enabled": true },

  /* `directory` is relative to this file, so it is the build output beside it, unprefixed.

     `not_found_handling` IS ABSENT, WHICH MEANS "none" — a plain 404. `"single-page-application"`
     would be wrong twice over: there is no client router here by default (`apps/site` prerenders
     every route and is readable with scripting off) and answering `index.html` with a 200 for
     every typo is the behaviour that makes a site look alive to a crawler and dead to a reader.
     `"404-page"` is the right answer the day `apps/site` prerenders a `404.html`; today's build
     does not have one, and pointing at a file that is not there is how a setting becomes a lie. */
  "assets": {
    "directory": "build"
  },

  /* Two environments for symmetry with `apps/worker/wrangler.jsonc`, and because the alternative
     is a marketing change that can only be seen after it is public. `routes` is an inheritable
     key, so — exactly as in the Worker's config — it is declared per environment and never at the
     top level, or `--env staging` would claim the apex.

     `assets` IS ALSO INHERITABLE and is deliberately left at the top level: both environments
     serve the same directory, and the whole point of staging is that the bytes are the same
     bytes. */
  "env": {
    /* `staging.brain.dog` — one label under the apex, so Universal SSL covers it with no
       Advanced Certificate Manager. The same argument as the app's `app-staging.brain.dog`. */
    "staging": {
      "routes": [{ "pattern": "staging.brain.dog", "custom_domain": true }]
    },

    /* THE APEX, AND `www` IS NOT HERE. A Worker can hold several Custom Domains, but this one has
       no code, so it cannot redirect — and giving it code to move `www` to the apex would be
       writing a request handler for a redirect that Cloudflare performs at the edge for free. The
       `www` → apex redirect is a single dashboard Redirect Rule; REPORT.md §1 has it as a numbered
       step. Two Workers cannot share one Custom Domain, so nothing else may claim `brain.dog`. */
    "production": {
      "routes": [{ "pattern": "brain.dog", "custom_domain": true }]
    }
  }
}
