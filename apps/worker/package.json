{
  "name": "@braindog/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "dependencies": {
    "@braindog/host": "workspace:*",
    "@braindog/kernel": "workspace:*",
    "@braindog/ports": "workspace:*",
    "@braindog/record": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250913.0",
    "wrangler": "4.42.0"
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "deploy:alpha": "wrangler deploy --env alpha",
    "deploy:production": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  }
}
