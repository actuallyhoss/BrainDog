<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Mac app, signed with Developer ID and its provisioning profile (M6). Sandboxed; the network for the web app and
  the calls; Downloads for exports and backups; passkeys through both names; the team-prefixed App Group and the
  Keychain group the widgets and the share extension read the session from; push (M4).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:brain.dog</string>
		<string>webcredentials:app.brain.dog</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)dog.brain</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dog.brain.shared</string>
	</array>
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
</dict>
</plist>
