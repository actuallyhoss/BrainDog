{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrainDog",
  "version": "0.1.0",
  "identifier": "dog.brain.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["braindog"] } }
  }
}
