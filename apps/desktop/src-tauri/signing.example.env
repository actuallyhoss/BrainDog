# Placeholders only, for his Apple Developer Program sitting. Export real values in the shell that runs the build;
# never write them into this file or any note. The Developer ID certificate stays in the Mac's keychain.
APPLE_SIGNING_IDENTITY="Developer ID Application: <LEGAL NAME> (<TEAM_ID>)"
APPLE_TEAM_ID="<TEAM_ID>"
# Notarisation: the Apple ID and an app-specific password.
APPLE_ID="<APPLE_ID_EMAIL>"
APPLE_PASSWORD="<APP_SPECIFIC_PASSWORD>"
# Updates: `cargo tauri signer generate -w ~/.tauri/braindog.key` makes the pair. The public key goes in
# tauri.conf.json (plugins.updater.pubkey); the private key and its password are exported for the build only.
TAURI_SIGNING_PRIVATE_KEY="<PATH_OR_CONTENTS_OF_PRIVATE_KEY>"
TAURI_SIGNING_PRIVATE_KEY_PASSWORD="<KEY_PASSWORD>"
