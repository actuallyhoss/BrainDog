# Cloudflare Workers static assets read this file; it is not served.
#
# A hashed file never changes under its name, so a browser keeps it for a year and never asks again.
# The app is served under `/app` on `brain.dog`, so its hashed files are too.
# Everything else (the shell, the fonts, the marks) keeps the platform's default, so a deploy is seen
# on the next load.
/app/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
