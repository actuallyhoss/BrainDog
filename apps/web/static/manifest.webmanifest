{
  "id": "/app/",
  "name": "BrainDog",
  "short_name": "BrainDog",
  "description": "Everything about your business that is not just code, in one record your agents can write to.",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "icons": [
    { "src": "/app/mark.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/app/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" },
    { "src": "/app/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Add a task", "short_name": "Add a task", "url": "/app/r/tasks?new=1", "icons": [{ "src": "/app/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Ask", "short_name": "Ask", "url": "/app/add", "icons": [{ "src": "/app/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": { "action": "/app/add", "method": "GET", "params": { "title": "title", "text": "text", "url": "url" } }
}
