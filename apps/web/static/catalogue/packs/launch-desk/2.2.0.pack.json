          "id": "name",
          "label": "Part",
          "type": "text",
          "required": true,
          "search": true
        },
        {
          "id": "what",
          "label": "What it is",
          "type": "text",
          "search": true
        },
        {
          "id": "big",
          "label": "Lead card",
          "type": "bool"
        },
        {
          "id": "progress",
          "label": "How far along",
          "type": "int",
          "min": 0,
          "max": 100
        },
        {
          "id": "hue",
          "label": "Colour",
          "type": "int",
          "min": 0,
          "max": 359
        },
        {
          "id": "picture",
          "label": "Picture",
          "type": "file"
        }
      ]
    },
    {
      "register": "steps",
      "name": "Steps",
      "one": "step",
      "holds": "what has to happen for each part, in order, and whether it is done",
      "title": "what",
      "fields": [
        {
          "id": "what",
          "label": "Step",
          "type": "text",
          "required": true,
          "search": true
        },
        {
          "id": "part",
          "label": "Part",
          "type": "ref",
          "to": "parts",
          "index": true
        },
        {
          "id": "done",
