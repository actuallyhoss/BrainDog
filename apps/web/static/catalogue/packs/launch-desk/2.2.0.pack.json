              "field": "name"
            },
            {
              "field": "status"
            },
            {
              "field": "phone"
            },
            {
              "field": "email"
            }
          ],
          "empty": "Nobody is helping with this part yet."
        }
      ]
    },
    {
      "page": "numbers",
      "title": "Numbers",
      "icon": "money",
      "nav": {
        "section": "Launch",
        "order": 90,
        "tabs": true
      },
      "requires": [
        "register.checks",
        "register.lines"
      ],
      "blocks": [
        {
          "kind": "section",
          "heading": "Does the price hold",
          "box": true
        },
        {
          "kind": "inputs",
          "register": "checks",
          "heading": "The price check",
          "columns": [
            {
              "field": "price"
            },
            {
              "field": "making"
            },
            {
              "field": "packing"
            },
            {
              "field": "sending"
            }
          ],
          "row": "checks#1"
        },
        {
