        },
        {
          "kind": "cards",
          "area": "rail",
          "source": "register.notes",
          "where": "about is {{spoken}}",
          "columns": [
            {
              "field": "text",
              "as": "title"
            },
            {
              "field": "reply",
              "as": "reply"
            }
          ],
