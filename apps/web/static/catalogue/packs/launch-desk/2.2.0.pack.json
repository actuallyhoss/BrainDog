{
  "pack": "launch-desk",
  "version": "2.2.0",
  "title": "Launch desk",
  "summary": "A desk for launching a thing in parts: where it stands in one sentence, each part in its own colour and picture with its next step, the steps on a calendar by the day they are due, the calls waiting on you, a pad beside it, and a price check.",
  "changes": "Tiles sit in even rows: on the desk the next move and what is already done stack in one box, the calls waiting on you come straight under the line and are shown once, and a part's own card sits at the top of the column beside its path.",
  "author": "BrainDog",
  "license": "Apache-2.0",
  "requires": {
    "format": 1,
    "primitives": 1,
    "packs": {
      "pad": ">=1.0.0"
    }
  },
