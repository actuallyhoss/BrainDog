{
  "pack": "hello",
  "version": "1.0.0",
  "title": "Hello",
  "summary": "A list of things to do and a page showing what is still open: the smallest useful add-on, in the shape braindog pack new starts every one.",
  "changes": "A record with seeds and no tags field refused its own rule with FIELD_UNKNOWN, like the CLI starter this pack copies; items now declares tags.",
  "author": "BrainDog",
  "license": "Apache-2.0",
  "requires": {
    "format": 1,
    "primitives": 1,
    "packs": {}
  },
  "declarations": [
    {
      "register": "items",
      "name": "Items",
      "title": "name",
      "fields": [
        {
          "id": "name",
          "type": "text",
          "required": true
        },
        {
          "id": "state",
          "type": "enum",
          "values": [
            "open",
            "done"
          ],
          "default": "open"
        },
        {
          "id": "due",
          "type": "day"
        },
        {
          "id": "tags",
          "type": "list",
          "of": "text"
        }
      ]
    },
    {
      "page": "hello",
      "title": "Hello",
      "nav": {
        "section": "Hello",
        "order": 10
      },
      "icon": "board",
      "requires": [
        "register.items"
      ],
      "blocks": [
        {
          "kind": "table",
          "heading": "Open",
          "span": 12,
          "source": "register.items",
          "where": "state is open",
          "columns": [
            {
              "field": "name",
              "label": "Item",
              "width": "minmax(20ch,1fr)"
            },
            {
              "field": "due",
              "label": "Due",
              "width": "14ch",
              "align": "end"
            }
          ],
          "order": [
            {
              "field": "due",
              "dir": "asc"
            }
          ],
          "limit": 20,
          "empty": "Nothing is open."
        }
      ]
    }
  ],
  "seeds": [
    {
      "register": "items",
      "fields": {
        "name": "Write the first real item",
        "due": "2026-10-01"
      }
    },
    {
      "register": "items",
      "fields": {
        "name": "Delete these two examples",
        "state": "done"
      }
    }
  ]
}
