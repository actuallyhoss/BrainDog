        {
          "code": "<svg id=\"c\" width=\"100%\" height=\"200\" role=\"img\" aria-label=\"Illustrated fund by year, low, mid and high\"></svg>\n<style>svg text{font:12px var(--font,system-ui,sans-serif);fill:var(--ink-2)}.l{fill:none;stroke-width:2}.k{font-weight:600}</style>\n<script>\nbraindog.on(function (d) {\n  var f = d.columns.map(function (c) { return c.field; });\n  var rows = d.rows.map(function (r) { return r.fields; }).filter(function (r) { return r.year && r.mid; }).sort(function (a, b) { return a.year - b.year; });\n  var svg = document.getElementById('c');\n  var out = '';\n  svg.innerHTML = '';\n  if (rows.length < 2) return;\n  var W = svg.clientWidth || 600, H = 200, L = 8, R = 56, T = 12, B = 22;\n  var val = function (m) { return m && typeof m.amount === 'number' ? m.amount : null; };\n  var all = [];\n  rows.forEach(function (r) { ['low', 'mid', 'high'].forEach(function (k) { var v = val(r[k]); if (v !== null) all.push(v); }); });\n  var lo = Math.min.apply(null, all), hi = Math.max.apply(null, all);\n  if (hi === lo) hi = lo + 1;\n  var y0 = rows[0].year, y1 = rows[rows.length - 1].year;\n  var x = function (y) { return L + ((y - y0) / Math.max(1, y1 - y0)) * (W - L - R); };\n  var y = function (v) { return T + (1 - (v - lo) / (hi - lo)) * (H - T - B); };\n  var add = function (name, attrs, text) { var a = ''; for (var k in attrs) a += ' ' + k + '=\"' + attrs[k] + '\"'; out += '<' + name + a + '>' + (text || '') + '</' + name + '>'; };\n  [['low', 'Low', 'var(--ink-3)'], ['mid', 'Mid', 'var(--ink)'], ['high', 'High', 'var(--good)']].forEach(function (s) {\n    var pts = rows.filter(function (r) { return val(r[s[0]]) !== null; });\n    add('polyline', { 'class': 'l', stroke: s[2], points: pts.map(function (r) { return x(r.year) + ',' + y(val(r[s[0]])); }).join(' ') });\n    var last = pts[pts.length - 1];\n    add('text', { x: x(last.year) + 6, y: y(val(last[s[0]])) + 4, 'class': 'k' }, s[1]);\n  });\n  add('text', { x: L, y: H - 6 }, String(y0));\n  add('text', { x: W - R, y: H - 6, 'text-anchor': 'end' }, String(y1));\n  svg.innerHTML = out;\n});\n</script>",
