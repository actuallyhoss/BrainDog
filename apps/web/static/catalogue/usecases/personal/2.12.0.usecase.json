  "pack": {
    "pack": "usecase-personal",
    "requires": {
      "format": 1,
      "primitives": 1,
      "packs": {}
    },
    "extends": {
      "register.people": {
        "values": {
          "role": [
            "family",
            "friend",
            "landlord",
            "tradesperson",
            "adviser"
          ]
        }
      }
    },
    "hands": {
      "metric.budgets-set": "money-core"
    },
    "declarations": [
      {
        "register": "savings_goals",
        "name": "Savings goals",
        "one": "savings goal",
        "icon": "star",
        "holds": "what you are saving for, how much it takes and how much is saved",
        "title": "name",
        "mobile": [
          "name",
          "target",
          "by"
        ],
        "state": "state",
        "done": [
          "reached"
        ],
        "fields": [
          {
            "id": "name",
            "label": "Saving for",
            "type": "text",
            "required": true,
            "search": true
          },
          {
            "id": "target",
            "label": "Target",
            "type": "money",
            "required": true
          },
          {
            "id": "saved",
            "label": "Saved before logging",
            "type": "money"
          },
          {
            "id": "by",
            "label": "By",
            "type": "day",
            "index": true
          },
          {
            "id": "account",
            "label": "Kept in",
            "type": "ref",
            "to": "accounts",
            "index": true
          },
          {
            "id": "state",
            "label": "Status",
            "type": "enum",
            "values": [
              "saving",
              "paused",
              "reached"
            ],
            "labels": {
              "saving": "Saving",
              "paused": "Paused",
              "reached": "Reached"
            },
            "default": "saving",
            "required": true,
            "index": true
          },
          {
            "id": "note",
            "label": "Notes",
            "type": "document"
          },
          {
            "id": "tags",
            "type": "list",
            "of": "text"
          }
        ]
      },
      {
        "register": "goals",
        "name": "Goals",
        "one": "goal",
        "icon": "check",
        "holds": "the goals and habits you keep, what you aim for and how far you have got",
        "title": "what",
        "mobile": [
          "what",
          "kind",
          "target"
        ],
        "state": "state",
        "done": [
          "done"
        ],
        "fields": [
          {
            "id": "what",
            "label": "Goal",
            "type": "text",
            "required": true,
            "search": true
          },
          {
            "id": "kind",
            "label": "Kind",
            "type": "enum",
            "values": [
              "habit",
              "goal"
            ],
            "labels": {
              "habit": "Habit",
              "goal": "Goal"
            },
            "default": "goal",
            "index": true
          },
          {
            "id": "done",
            "label": "Done before logging",
            "type": "decimal"
          },
          {
            "id": "target",
            "label": "Aim",
            "type": "decimal",
            "required": true
          },
          {
            "id": "unit",
            "label": "Counted in",
            "type": "text"
          },
          {
            "id": "by",
            "label": "By",
            "type": "day",
            "index": true
          },
          {
            "id": "state",
            "label": "Status",
            "type": "enum",
            "values": [
              "active",
              "paused",
              "done"
            ],
            "labels": {
              "active": "Active",
              "paused": "Paused",
              "done": "Done"
            },
            "default": "active",
            "required": true,
            "index": true
          },
          {
            "id": "note",
            "label": "Notes",
            "type": "document"
          },
          {
            "id": "tags",
            "type": "list",
            "of": "text"
          }
        ]
      },
      {
        "register": "goal_log",
        "name": "Progress",
        "one": "progress entry",
        "icon": "check",
        "holds": "each run, book or night in that counts toward a habit or a goal, and how much",
        "title": "what",
        "mobile": [
          "what",
          "goal",
          "on"
        ],
        "fields": [
          {
            "id": "what",
            "label": "What",
            "type": "text",
            "required": true,
            "search": true
          },
          {
            "id": "goal",
            "label": "Counts toward",
            "type": "ref",
            "to": "goals",
            "index": true
          },
          {
            "id": "amount",
            "label": "How much",
            "type": "decimal",
            "required": true,
            "default": 1
          },
          {
            "id": "on",
            "label": "Day",
            "type": "day",
            "required": true,
            "index": true
          },
          {
            "id": "note",
            "label": "Notes",
            "type": "text"
          },
          {
            "id": "tags",
            "type": "list",
            "of": "text"
          }
        ]
      },
      {
        "register": "put_by",
        "name": "Money saved",
        "one": "saving",
        "icon": "money",
        "holds": "each amount set aside toward a savings goal, and when",
        "title": "what",
        "mobile": [
          "what",
          "amount",
          "on"
        ],
        "fields": [
          {
            "id": "what",
            "label": "What",
            "type": "text",
            "required": true,
            "search": true
          },
          {
            "id": "saving",
            "label": "Toward",
            "type": "ref",
            "to": "savings_goals",
            "index": true
          },
          {
            "id": "amount",
            "label": "Amount",
            "type": "money",
            "required": true
          },
          {
            "id": "on",
            "label": "Day",
            "type": "day",
            "required": true,
            "index": true
          },
          {
            "id": "note",
            "label": "Notes",
            "type": "text"
          },
          {
            "id": "tags",
            "type": "list",
            "of": "text"
          }
        ]
      },
      {
        "register": "project_steps",
        "name": "Project steps",
        "one": "project step",
        "icon": "task",
        "holds": "the steps each project takes, and which are done",
        "title": "what",
        "steps": {
          "of": "thing",
          "done": "done"
        },
        "mobile": [
          "what",
          "thing",
          "done"
        ],
        "fields": [
          {
            "id": "what",
            "label": "Step",
            "type": "text",
            "required": true,
            "search": true
          },
          {
            "id": "thing",
            "label": "Project",
            "type": "ref",
            "to": "things",
            "index": true
          },
          {
            "id": "done",
            "label": "Done",
            "type": "bool",
            "default": false,
            "index": true
          },
          {
            "id": "by",
            "label": "By",
            "type": "day",
            "index": true
          },
          {
            "id": "note",
            "label": "Notes",
            "type": "text"
          },
          {
            "id": "tags",
            "type": "list",
            "of": "text"
          }
        ]
      },
      {
        "metric": "logged-this-week-by-goal",
        "name": "Logged this week, by goal",
        "source": "register.goal_log",
        "where": {
          "field": "on",
          "gte": "bow"
        },
        "value": {
          "sum": "amount"
        },
        "group_by": "goal",
        "format": "decimal",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "logged-by-goal",
        "name": "Logged, by goal",
        "source": "register.goal_log",
        "value": {
          "sum": "amount"
        },
        "group_by": "goal",
        "format": "decimal",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "put-by-by-goal",
        "name": "Saved, by savings goal",
        "source": "register.put_by",
        "value": {
          "sum": "amount"
        },
        "group_by": "saving",
        "format": "money",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "saved-toward-goals",
        "name": "Saved toward goals",
        "source": "register.put_by",
        "value": {
          "sum": "amount"
        },
        "format": "money",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "savings-active",
        "name": "Savings goals on the go",
        "source": "register.savings_goals",
        "where": "state is not paused",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "goals-active",
        "name": "Goals on the go",
        "source": "register.goals",
        "where": "state is active, kind is goal",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "habits-active",
        "name": "Habits on the go",
        "source": "register.goals",
        "where": "state is active, kind is habit",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "savings-held",
        "name": "Savings goals kept",
        "source": "register.savings_goals",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "goals-held",
        "name": "Goals and habits",
        "source": "register.goals",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "goal-log-held",
        "name": "Logged",
        "source": "register.goal_log",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "put-by-held",
        "name": "Money saved",
        "source": "register.put_by",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "steps-left",
        "name": "Steps left on a project",
        "source": "register.project_steps",
        "where": "thing is {{it}}, done is false",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "steps-done",
        "name": "Steps done on a project",
        "source": "register.project_steps",
        "where": "thing is {{it}}, done is true",
        "value": {
