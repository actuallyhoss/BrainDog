            "columns": [
              {
                "field": "what"
              },
              {
                "field": "target"
              },
              {
                "field": "unit"
              }
            ],
            "toward": "logged-this-week-by-goal",
            "order": [
              {
                "field": "seq",
                "dir": "asc"
              }
