      {
        "page": "home-personal",
        "title": "Day to day",
        "icon": "home",
        "requires": [
          "register.accounts",
          "register.categories",
          "register.things",
          "register.project_steps",
          "register.goals",
          "register.goal_log",
          "register.savings_goals"
        ],
        "blocks": [
          {
            "kind": "note",
            "lead": true,
            "span": 12,
            "body": "{{cash-now}} in my accounts, {{arriving-30d}} coming in and {{leaving-30d}} going out in the next 30 days"
          },
          {
            "kind": "queue",
            "heading": "{{config:voice_needs_you}}",
            "icon": "ask",
            "span": 12,
            "source": "governance.open",
            "limit": 5,
            "when": {
              "metric": "questions-open",
              "gt": 0
            },
            "empty": "{{config:voice_nothing_needs_you}}"
          },
          {
            "kind": "link",
            "heading": "Bring your money in",
            "icon": "plug",
            "span": 12,
            "when": {
              "metric": "cash-accounts",
              "lt": 1
            },
            "authored": [
              {
                "cells": [
                  "Add an account",
                  "/r/accounts?new=1",
                  "What is in it today, and every figure on Home starts from it"
                ]
              },
              {
                "cells": [
                  "Forward a bank message",
                  "/settings/ingest",
                  "What you spent files itself from the texts your bank sends"
                ]
              },
              {
                "cells": [
                  "Find a plugin for your bank",
                  "/packs/browse?q=money",
                  "Balances and payments arrive on their own"
                ]
              }
            ]
          },
          {
            "kind": "capture",
            "heading": "Name something you are saving for",
            "icon": "piggy-bank",
            "span": 12,
            "register": "savings_goals",
            "when": {
              "metric": "savings-held",
              "lt": 1
            }
          },
          {
            "kind": "capture",
            "heading": "Name something you are making",
            "icon": "rocket",
            "span": 12,
            "register": "things",
            "where": "lane is building",
            "when": {
              "metric": "projects-live",
              "lt": 1
            }
          },
          {
            "kind": "timeline",
            "heading": "Coming up",
            "icon": "calendar-clock",
            "span": 12,
            "source": "deadlines",
            "horizon": 14,
            "columns": [
              {
                "field": "day"
              },
              {
                "field": "title"
              },
              {
                "field": "amount",
                "sign": {
                  "field": "direction",
                  "minus": "out"
                }
              }
            ],
            "limit": 12,
            "empty": "Nothing falls due in the next two weeks."
          },
          {
            "kind": "progress",
            "heading": "Budget left",
            "icon": "wallet",
            "span": 12,
            "when": {
              "metric": "budgets-set",
              "gt": 0
            },
            "source": "register.categories",
            "where": "state is live, direction is out, budget is set",
            "columns": [
              {
                "field": "name"
              },
              {
                "field": "budget"
              }
            ],
            "spent": "spent-by-category-month",
            "order": [
              {
                "field": "seq",
                "dir": "asc"
              }
            ],
            "limit": 10,
            "empty": "No budget yet. Give a category the most you mean to spend on it in a month, and what is left shows here."
          },
          {
            "kind": "cards",
            "heading": "My projects",
            "icon": "rocket",
            "span": 12,
            "source": "register.things",
            "where": "lane is building or earning",
            "columns": [
              {
                "field": "name",
                "as": "title"
              },
              {
                "field": "lane",
                "label": "Status",
                "as": "fact"
              },
              {
                "field": "what",
                "label": "Next",
                "as": "next"
              }
            ],
            "order": [
              {
                "field": "seq",
                "dir": "asc"
              }
            ],
            "limit": 6,
            "when": {
              "metric": "projects-live",
              "gt": 0
            },
            "empty": "No projects on the go. Add one you make or do for the love of it, and its next step shows here."
          },
          {
            "kind": "progress",
            "heading": "Goals",
            "icon": "goal",
            "span": 12,
            "when": {
              "metric": "goals-active",
              "gt": 0
            },
            "source": "register.goals",
            "where": "state is active, kind is goal",
            "columns": [
              {
                "field": "what"
              },
              {
                "field": "target"
              },
              {
                "field": "unit"
              }
            ],
            "toward": "logged-by-goal",
            "order": [
              {
                "field": "seq",
                "dir": "asc"
              }
            ],
            "limit": 8,
            "empty": "No goals yet. Add one, like running a hundred kilometres, and log each step toward it."
          },
          {
            "kind": "progress",
            "heading": "Habits this week",
            "icon": "repeat",
            "span": 12,
            "when": {
              "metric": "habits-active",
              "gt": 0
            },
            "source": "register.goals",
            "where": "state is active, kind is habit",
            "columns": [
              {
                "field": "what"
              },
              {
                "field": "target"
              },
              {
                "field": "unit"
              }
            ],
            "toward": "logged-this-week-by-goal",
            "order": [
              {
                "field": "seq",
                "dir": "asc"
              }
            ],
            "limit": 8,
            "empty": "No habits yet. Add one, like running three times a week, and log each time."
          },
          {
            "kind": "section",
            "heading": "{{config:voice_since_away}}",
            "icon": "history",
            "span": 12,
            "fold": true
          },
          {
            "kind": "feed",
            "span": 12,
            "source": "activity",
            "since": "seen",
            "first": 8,
            "empty": "Nothing new since you last looked."
          }
        ]
      },
      {
        "page": "goals",
        "title": "Goals",
        "nav": {
