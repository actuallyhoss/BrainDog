        "blocks": [
          {
            "kind": "note",
            "lead": true,
            "span": 12,
            "body": "Cash is {{cash-now}} across {{cash-accounts}} account(s), and on what is due it runs out in {{runway-days}} day(s).",
            "when": {
              "all": [
                {
                  "metric": "books-held",
                  "lt": 2
                },
                {
                  "metric": "runway-days",
                  "beyond": false
                }
              ]
            }
          },
          {
            "kind": "note",
            "lead": true,
            "span": 12,
            "body": "Cash is {{cash-now}} across {{cash-accounts}} account(s), and on what is due it lasts the year.",
            "when": {
              "all": [
                {
                  "metric": "books-held",
                  "lt": 2
                },
                {
                  "metric": "runway-days",
                  "beyond": true
                }
              ]
            }
          },
