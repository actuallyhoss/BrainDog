  "labels": {},
  "pack": {
    "pack": "usecase-founder",
    "requires": {
      "format": 1,
      "primitives": 1,
      "packs": {}
    },
    "declarations": [
      {
        "metric": "datapoints-30d",
        "name": "Numbers reported, 30 days",
        "source": "register.datapoints",
        "where": "at after -30d, source is not example, at before tomorrow",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 1
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "datapoints-held",
        "name": "Numbers",
        "source": "register.datapoints",
        "where": "at before tomorrow",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "organisations-held",
        "name": "Organisations",
        "source": "register.organisations",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "due-this-week",
        "name": "Due this week",
        "source": "register.obligations",
        "where": "state is open or part, due after -1d, due before +8d",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "late-money",
        "name": "Late",
        "source": "register.obligations",
        "where": "state is open or part, due before today",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "datapoints-7d",
        "name": "Numbers reported, 7 days",
        "source": "register.datapoints",
        "where": "at after -7d, source is not example, at before tomorrow",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "datapoints-reported",
        "name": "Numbers reported",
        "source": "register.datapoints",
        "where": "source is not example, at before tomorrow",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "lapsing-30d",
        "name": "Lapsing within 30 days",
        "source": "register.services",
        "where": "state is lapsing, renews after -31d, renews before +31d",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "project-numbers-7d",
        "name": "Numbers this week",
        "source": "register.datapoints",
        "where": "thing is {{it}}, at after -7d, source is not example, at before tomorrow",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "datapoints-age",
        "name": "Days since a number was reported",
        "source": "register.datapoints",
        "where": "source is not example, at before tomorrow",
        "value": {
          "age": "at"
        },
        "format": "int",
        "target": {
          "lte": 6
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "service-numbers",
        "name": "Server and provider numbers",
        "source": "register.datapoints",
        "where": "about_service is set, source is not example, at before tomorrow, at after -90d",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "projects-earning-silent",
        "name": "Earning, silent 90 days",
        "source": "register.things",
        "where": {
          "none": [
            {
              "field": "lane",
              "not": "earning"
            },
            {
              "pointed": {
                "register": "transactions",
                "by": "thing",
                "where": {
                  "all": [
                    {
                      "field": "state",
                      "is": "cleared"
                    },
                    {
                      "field": "direction",
                      "is": "in"
                    },
                    {
                      "field": "transfer",
                      "is": false
                    },
                    {
                      "field": "on",
                      "after": "-90d"
                    }
                  ]
                }
              }
            },
            {
              "pointed": {
                "register": "datapoints",
                "by": "thing",
                "where": {
                  "all": [
                    {
                      "field": "at",
                      "after": "-90d"
                    },
                    {
                      "field": "source",
                      "not": "example"
                    }
                  ]
                }
              }
            }
          ]
        },
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "lte": 0
        },
        "window": "90d",
        "compare": "none"
      },
      {
        "page": "home-founder",
        "title": "Founder overview",
        "icon": "home",
