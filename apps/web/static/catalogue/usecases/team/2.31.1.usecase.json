        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "tickets-taken",
        "name": "Taken by agents",
        "source": "register.tasks",
        "where": "agent is set, state is not done or dropped",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "metric": "tickets-done-by-agents",
        "name": "Finished by agents",
        "source": "register.tasks",
        "where": "agent is set, state is done",
        "value": {
          "count": "id"
        },
        "format": "int",
        "target": {
          "gte": 0
        },
        "window": "30d",
        "compare": "none"
      },
      {
        "rule": "ticket_done_ticks_plan",
        "pack": "usecase-team",
        "on": {
          "written": {
            "register": "tasks",
            "op": [
              "update"
            ],
            "fields": [
              "state"
            ]
          }
        },
        "when": "state is done",
        "steps": [
          {
            "script": {
              "id": "plan_follows_ticket",
              "as": "ticking"
            }
          }
        ]
      },
      {
        "rule": "ticket_reopened_unticks_plan",
        "pack": "usecase-team",
        "on": {
          "written": {
            "register": "tasks",
            "op": [
              "update"
            ],
            "fields": [
              "state"
            ]
          }
        },
        "when": "state is not done",
        "steps": [
          {
            "script": {
              "id": "plan_follows_ticket",
              "as": "unticking"
            }
          }
        ]
      },
      {
        "rule": "cycle_day_each_morning",
        "pack": "usecase-team",
        "on": {
          "every": "1d",
          "at": "06:00"
        },
        "steps": [
          {
            "script": {
              "id": "cycle_day",
              "as": "counting"
            }
          }
        ]
      },
      {
        "script": "plan_follows_ticket",
        "title": "Tick a planned ticket when its ticket is done",
        "pack": "usecase-team",
        "runs": {
          "rule": true
        },
        "egress": [],
        "keys": [],
        "reads": [
          "tasks",
          "cycle_plan"
        ],
        "writes": [
          "cycle_plan"
        ],
        "source": "export default async function run(ctx) {\n  const ticket = await ctx.record.get(ctx.input.id);\n  if (!ticket) return;\n  const done = ticket.fields.state === 'done';\n  const lines = await ctx.record.list('cycle_plan', { all: [{ field: 'task', is: ticket.id }] });\n  for (const line of lines)\n    if ((line.fields.done === true) !== done) ctx.update('cycle_plan#' + line.seq, { done }, line.version);\n}"
      },
      {
        "script": "cycle_day",
        "title": "Count the sprint's open tickets each morning",
        "pack": "usecase-team",
        "runs": {
          "rule": true
        },
        "egress": [],
        "keys": [],
        "reads": [
          "cycles",
          "cycle_plan",
          "cycle_days",
          "tasks"
        ],
        "writes": [
          "cycle_plan",
          "cycle_days"
        ],
        "source": "export default async function run(ctx) {\n  const today = ctx.today();\n  const cycles = await ctx.record.list('cycles', { all: [{ field: 'state', is: 'active' }] });\n  if (cycles.length === 0) return;\n  const written = await ctx.record.list('cycle_days', { all: [{ field: 'day', is: today }] });\n  if (written.some((d) => !d.fields.cycle)) return;\n  for (const cycle of cycles) {\n    if (written.some((d) => d.fields.cycle === cycle.id)) continue;\n    const lines = await ctx.record.list('cycle_plan', { all: [{ field: 'cycle', is: cycle.id }, { field: 'done', is: false }] });\n    let open = 0;\n    for (const line of lines) {\n      const ticket = line.fields.task ? await ctx.record.get(line.fields.task) : null;\n      if (ticket && ticket.fields.state === 'done') ctx.update('cycle_plan#' + line.seq, { done: true }, line.version);\n      else open++;\n    }\n    ctx.write('cycle_days', { day: today, open, cycle: cycle.id });\n  }\n}"
      },
