  },
  "devDependencies": {
    "@braindog/record": "workspace:*",
    "@braindog/skin": "workspace:*",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
