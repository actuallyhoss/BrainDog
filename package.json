{
  "name": "braindog",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.13"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 run test && node --test docs/test/*.test.mjs && node --test tools/people/test/*.test.mjs && node --test tools/people/expect/*.test.mjs && node --test tools/agent-bench/test/*.test.mjs",
    "typecheck": "pnpm -r run typecheck",
    "conformance": "pnpm --filter @braindog/selfhost run conformance; pnpm --filter @braindog/worker run conformance; pnpm --filter @braindog/host run conformance:compare",
    "gates": "node tools/gates/run.mjs",
    "release": "node tools/release.mjs",
    "dev": "pnpm --filter @braindog/web dev",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "shots": "node tools/look/run.mjs",
    "theme": "pnpm --filter @braindog/skin theme",
    "proof": "pnpm --filter @braindog/theme run proof",
    "dev:site": "pnpm --filter @braindog/site dev",
    "shots:site": "pnpm --filter @braindog/site exec node scripts/shot.mjs",
    "shots:product": "pnpm --filter @braindog/site exec node scripts/product.mjs",
    "door-check": "node tools/door-check/run.mjs",
    "ship:ci": "node tools/ship/ci.mjs",
    "ship:deploy": "node tools/ship/deploy.mjs",
    "drill:pay": "node tools/drill/pay.mjs",
    "drill:live": "node tools/drill/live.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "axe-core": "4.14.0",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
