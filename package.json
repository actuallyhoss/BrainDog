{
  "name": "braindog",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.13"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "typecheck": "pnpm -r run typecheck",
    "gates": "node tools/gates/run.mjs",
    "dev": "pnpm --filter @braindog/web dev",
    "build": "pnpm --filter @braindog/web build",
    "shots": "pnpm --filter @braindog/web exec node scripts/shot.mjs",
    "proof": "pnpm --filter @braindog/theme run proof"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.0",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
