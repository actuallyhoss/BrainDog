{
  /*
   * RENOVATE, NOT DEPENDABOT, AND THE DECIDING ARGUMENT IS ALREADY IN `pnpm-workspace.yaml`.
   *
   * That file says `minimumReleaseAge: 1440` — pnpm refuses to install a package published less
   * than 24 hours ago (31 §3; 52 §8 lists it as an install boundary). A bot that opens a pull
   * request the hour a version lands therefore opens a pull request whose install FAILS, goes red
   * for a day, and goes green on a re-run nobody triggers. Renovate has the same idea as a
   * first-class setting (`minimumReleaseAge` below, set past pnpm's floor), so the bot and the
   * install agree about what is too new.
   *
   * THE SECOND ARGUMENT IS GROUPING, AND IT IS WHAT MAKES THE UPDATES LAND AT ALL. `svelte`,
   * `@sveltejs/kit`, `@sveltejs/vite-plugin-svelte`, `@sveltejs/adapter-static`, `svelte-check` and
   * `vite` move as one thing across two apps; a bot that raises six single-package pull requests
   * raises six that do not build. Renovate groups them into one. Dependabot's grouping is by
   * pattern within one ecosystem and cannot express "these six, across the workspace, together".
   *
   * THE THIRD IS THAT IT CLOSES `ci.yml`'S OWN COMPROMISE. `pinDigests` rewrites `actions/checkout@v4`
   * to a 40-character digest with the tag beside it and then maintains the digest — which is the
   * only version of action pinning that is both safe and kept current.
   *
   * WHAT IT COSTS: a GitHub App with write access to this repository, which Dependabot does not
   * need. That is a real price and it is the reason to read the rules below rather than inherit
   * somebody's preset and hope.
   */

  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],

  timezone: 'Europe/London',
  /* ONE MORNING A WEEK. Dependency review is a task with a slot, not an interruption; a bot that
     raises pull requests on a Wednesday afternoon is a bot whose pull requests are read on a
     Wednesday afternoon. */
  schedule: ['before 7am on monday'],

  /* ONE ISSUE INSTEAD OF TEN PULL REQUESTS. The dashboard lists everything waiting, including the
     majors held back below, so "what is out of date" is answerable without opening the pull request
     list. */
  dependencyDashboard: true,

  /* Commit subjects here are sentences about what changed and why (`git log` reads as a changelog).
     `chore(deps):` in that history is a prefix that says nothing and breaks the one convention the
     repository has. */
  semanticCommits: 'disabled',

  /* PAST pnpm's 1440-MINUTE FLOOR, with room. Three days also covers the window in which a bad
     publish is unpublished or deprecated, which is the class of supply-chain accident a solo
     repository has no other defence against. */
  minimumReleaseAge: '3 days',

  /* Every version in this workspace is exact — `typescript: 6.0.3`, `svelte: 5.57.0`,
     `@playwright/test: 1.62.1`. A caret would mean the lockfile and the manifest disagree about what
     is being tested. */
  rangeStrategy: 'pin',
  postUpdateOptions: ['pnpmDedupe'],

  /* A queue of fifteen open update branches is a queue nobody reads. */
  prConcurrentLimit: 3,
  prHourlyLimit: 2,

  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 7am on the first day of the month'],
  },

  packageRules: [
    {
      /* PEER RANGES ARE STATEMENTS ABOUT CONSUMERS, not versions this repository installs.
         `braindog-render` peers `svelte: ^5`, which is a promise to a dependent that any Svelte 5
         works; narrowing it to today's patch would break dependents to no benefit here. */
      matchDepTypes: ['peerDependencies'],
      enabled: false,
    },
    {
      groupName: 'svelte, kit and vite',
      matchPackageNames: ['svelte', '@sveltejs/**', 'vite', 'svelte-check'],
      /* AND THE LABEL IS THE POINT OF THE GROUP. `gates.yml` runs the browser gates on a pull
         request only when it carries `full-gates`; this is the update most likely to move a byte
         count, a rendered box or a prerendered route, so it asks for the nineteen minutes itself. */
      addLabels: ['full-gates'],
    },
    {
      groupName: 'the browser gate toolchain',
      matchPackageNames: ['@playwright/test', 'axe-core'],
      /* These two decide WHAT `a11y` and `layout` report. A new axe-core finds rules the last one
         did not, which is a red gate that is not a regression — and the only sane place to learn
         that is a pull request that ran them. */
      addLabels: ['full-gates'],
    },
    {
      groupName: 'the Cloudflare toolchain',
      matchPackageNames: ['wrangler', '@cloudflare/**'],
    },
    {
      /* `@types/node` TRACKS THE RUNTIME, NOT THE REGISTRY. Every workflow pins Node 24.13.0 and
         `engines` says `>=24.13`; types for 25 would typecheck against APIs the runtime does not
         have, which is the one failure a type system is supposed to prevent. */
      matchPackageNames: ['@types/node'],
      allowedVersions: '<25',
    },
    {
      /* SUPPLY-CHAIN PINNING FOR THE FOUR ACTIONS `ci.yml` DOCUMENTS. Renovate rewrites
         `uses: actions/checkout@v4` to `uses: actions/checkout@<sha> # v4.3.1` and then keeps the
         digest current — the mutable-tag exposure closes and the update path stays open. */
      matchManagers: ['github-actions'],
      pinDigests: true,
      groupName: 'the workflow actions',
    },
    {
      /* A MAJOR IS A READING TASK, NOT A MERGE. It waits on the dashboard until somebody ticks it,
         so a Svelte 6 or a TypeScript 7 arrives when there is time to read the release notes rather
         than as a red pull request on a Monday. */
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
  ],
}
