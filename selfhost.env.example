# BrainDog self-host settings. Copy to .env and fill in the first two; every other line is optional.
# No value here is a secret until you put one there, and .env must stay out of git.

# Who owns the record. The first start makes it for this address and prints a one-time sign-in link. Required on first run.
BRAINDOG_OWNER=
# The server key: opens the server to your network and signs in the command line. Make one with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
BRAINDOG_TOKEN=

# The name of the first record. Default: home
#BRAINDOG_RECORD=home
# The address you open it at, for sign-in links and passkeys. Passkeys need https or localhost. Default: http://localhost:8080
#BRAINDOG_ORIGIN=https://brain.example.com
# The port on your machine for docker compose. Default: 8080
#BRAINDOG_PORT=8080
# The port the server listens on inside. Default: 8080
#PORT=8080
# The interface to listen on. Default: all of them when a server key is set, loopback only without one
#BRAINDOG_HOST=0.0.0.0
# Set to 1 only behind a reverse proxy you run, so rate limits see the real caller
#BRAINDOG_TRUST_PROXY=1
# Serve https from this process: paths to a certificate and its key, set together
#BRAINDOG_TLS_CERT=/data/tls/cert.pem
#BRAINDOG_TLS_KEY=/data/tls/key.pem

# Where the record lives. Default: /data, the volume
#BRAINDOG_DATA=/data
# The root key file that seals the vault. Default: <data>/kek, made on first run. Back it up with the record
#BRAINDOG_KEK_FILE=/data/kek
# A separate session key (32+ characters). Default: derived from the key file
#BRAINDOG_SESSION_SECRET=
# Refuse every token made before this instant, such as 2026-10-20T12:00:00Z
#BRAINDOG_TOKENS_VALID_FROM=
# The UTC time of the nightly copy kept beside the record, HH:MM, or off. Default: 03:20
#BRAINDOG_BACKUP_AT=03:20

# Mail for sign-in links and notices: smtps://user:pass@host:465 or smtp://...:587, and the sender. Default: mail is off
#BRAINDOG_SMTP_URL=
#BRAINDOG_MAIL_FROM=
# Let add-ons and scheduled actions send requests to other servers: on or off. Default: off
#BRAINDOG_OUTBOUND=off
# Where the public add-on registry is read from, or off for none. Default: the BrainDog registry
#BRAINDOG_KENNEL=off
# A folder of add-ons of your own, read before the registry. Default: the one built into the app
#BRAINDOG_CATALOGUE=

# A model for Slash on this host, all three or none. Default: off, and each person can add their own key in the app
#SLASH_FALLBACK_ENDPOINT=
#SLASH_FALLBACK_MODEL=
#SLASH_FALLBACK_KEY=
# Slash's first looks a day for a stranger's first sentence. Default: the built-in limit
#FIRST_READ_DAILY=
# Cloudflare Turnstile secret. Self-host has no public sign-up, so leave it unset
#TURNSTILE_SECRET=

# Advanced, for developers: serve one record file instead of the data directory, or a different built app
#BRAINDOG_FILE=
#BRAINDOG_SHELL=
# What /api/version reports as the app build. The image sets none
#BRAINDOG_BUILD=
