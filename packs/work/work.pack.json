{
  "pack": "work",
  "version": "1.26.2",
  "title": "Work",
  "summary": "Tasks, the threads of work they belong to, and how each thread is going.",
  "changes": "With no People on the record, Work draws Late, Your work this week, After this week and No due day again. Tasks with a day were on none of its lists.",
  "author": "BrainDog",
  "license": "MIT",
  "requires": { "format": 1, "primitives": 1, "packs": {} },
  "words": {
    "tracks": { "name": "Threads", "one": "thread" },
    "updates": { "name": "Updates", "one": "update" },
    "tasks": { "name": "Tasks", "one": "task" }
  },
  "declarations": [
    {
      "register": "tracks",
      "icon": "rows",
      "name": "Threads",
      "one": "thread",
      "holds": "the lines of work you are in the middle of, and what each one is waiting on",
      "title": "name",
      "mobile": [ "name", "thing", "state" ],
      "state": "state",
      "done": [ "done", "dropped" ],
      "pack": "work",
      "fields": [
        { "id": "name", "type": "text", "required": true, "search": true },
        {
          "id": "state",
          "label": "Status",
          "type": "enum",
          "values": [ "idea", "planned", "open", "holding", "done", "dropped" ],
          "labels": {
            "idea": "Idea",
            "planned": "Planned",
            "open": "Open",
            "holding": "Holding",
            "done": "Done",
            "dropped": "Dropped"
          },
          "transitions": {
            "idea": { "to": [ "planned", "open", "dropped" ] },
            "planned": { "to": [ "idea", "open", "holding", "dropped" ] },
            "open": { "to": [ "holding", "done", "dropped" ] },
            "holding": { "to": [ "planned", "open", "done", "dropped" ] },
            "done": { "to": [ "open" ] },
            "dropped": { "to": [ "idea", "open" ] }
          },
          "index": true,
          "required": true
        },
        {
          "id": "thing",
          "label": "Project",
          "type": "ref",
          "to": "things",
          "index": true,
          "when": { "holds": [ "things" ] }
        },
        { "id": "opened", "type": "day", "index": true },
        {
          "id": "target",
          "label": "Aiming for",
          "type": "day",
          "index": true,
          "deadline": true,
          "remind": [ "0d" ]
        },
        { "id": "note", "type": "document" },
        { "id": "tags", "type": "list", "of": "text" }
      ]
    },
    {
      "register": "updates",
      "icon": "doc",
      "name": "Updates",
      "one": "update",
      "holds": "what was true about a thread on a date, who said so, and how it was going",
      "title": "body",
      "mobile": [ "body", "health", "at" ],
      "pack": "work",
      "fields": [
        { "id": "body", "label": "Update", "type": "document", "required": true, "search": true },
        {
          "id": "health",
          "type": "enum",
          "values": [ "on_track", "at_risk", "off_track" ],
          "labels": { "on_track": "On track", "at_risk": "At risk", "off_track": "Off track" },
          "index": true,
          "required": true
        },
        { "id": "track", "label": "Thread", "type": "ref", "to": "tracks", "index": true, "required": true },
        { "id": "by", "type": "text", "index": true, "required": true },
        { "id": "at", "label": "When", "type": "instant", "index": true, "required": true },
        { "id": "supersedes", "label": "Replaces", "type": "ref", "to": "updates" },
        { "id": "tags", "type": "list", "of": "text" }
      ]
    },
    {
      "register": "tasks",
      "icon": "task",
      "name": "Tasks",
      "one": "task",
      "holds": "work with a state and a date, who holds it, and which agent took it, so nothing is carried in your head",
      "title": "what",
      "mobile": [ "what", "thing", "state" ],
      "state": "state",
      "done": [ "done", "dropped" ],
      "finished": "done_on",
      "hand": { "person": "owner", "agent": "agent", "taken": "doing" },
      "pack": "work",
      "fields": [
        { "id": "what", "label": "Task", "type": "text", "required": true, "search": true },
        {
          "id": "state",
          "label": "Status",
          "type": "enum",
          "values": [ "backlog", "open", "doing", "review", "blocked", "done", "dropped" ],
          "labels": { "backlog": "Later", "review": "To check" },
          "default": "open",
          "index": true,
          "required": true
        },
        {
          "id": "priority",
          "label": "Priority",
          "type": "enum",
          "values": [ "urgent", "high", "normal", "low" ],
          "labels": { "urgent": "Urgent", "high": "High", "normal": "Normal", "low": "Low" }
        },
        { "id": "why", "label": "Why this tier", "type": "text" },
        {
          "id": "owner",
          "label": "Assigned to",
          "type": "ref",
          "to": "people",
          "index": true,
          "when": { "holds": [ "people" ] }
        },
        { "id": "agent", "label": "Agent", "type": "text", "index": true },
        { "id": "parent", "label": "Part of", "type": "ref", "to": "tasks", "index": true },
        { "id": "done_on", "label": "Done on", "type": "day", "index": true },
        {
          "id": "thing",
          "label": "Project",
          "type": "ref",
          "to": "things",
          "index": true,
          "scope": {},
          "when": { "holds": [ "things" ] }
        },
        {
          "id": "client",
          "label": "Client",
          "type": "ref",
          "to": "organisations",
          "qualifies": "thing",
          "when": { "holds": [ "organisations" ] }
        },
        { "id": "by", "label": "Due", "type": "day", "index": true, "deadline": true, "remind": [ "0d" ] },
        { "id": "track", "label": "Thread", "type": "ref", "to": "tracks", "index": true },
        { "id": "effort", "type": "duration", "unit": "d" },
        { "id": "note", "type": "document" },
        { "id": "tags", "type": "list", "of": "text" }
      ]
    },
    {
      "page": "work",
      "title": "Work",
      "nav": { "section": "Work", "order": 10, "place": 10 },
      "icon": "task",
      "requires": [ "register.tasks" ],
      "pack": "work",
      "header": { "count": { "metric": "open-tasks" }, "action": { "verb": "row.create", "label": "Add" } },
      "filters": [
        {
          "field": "thing",
          "control": "chips",
          "counts": "state is not backlog or done or dropped",
          "when": { "holds": [ "things" ] }
        },
        {
          "field": "whose",
          "control": "segmented",
          "counts": "state is not backlog or done or dropped",
          "options": [
            { "value": "yours", "label": "Yours", "where": "agent is empty, owner is not someone else" },
            { "value": "agents", "label": "Agents", "where": "agent is set" }
          ]
        }
      ],
      "blocks": [
        {
          "kind": "note",
          "lead": true,
          "span": 12,
          "when": { "metric": "open-tasks", "is": 0 },
          "body": "Nothing is open right now"
        },
        { "kind": "capture", "heading": "What needs doing?", "icon": "plus", "span": 12, "register": "tasks" },
        {
          "kind": "queue",
          "heading": "Questions for you",
          "icon": "ask",
          "span": 12,
          "source": "governance.open",
          "where": "list is tasks",
          "limit": 3,
          "tiles": true,
          "when": { "metric": "questions-open-in:tasks", "gt": 0 }
        },
        {
          "kind": "todo",
          "heading": "Late",
          "icon": "calendar-days",
          "span": 6,
          "source": "register.tasks",
          "where": "state is open or doing, agent is empty, owner is not someone else, by before today",
          "columns": [
            { "field": "what" },
            { "field": "by" },
            { "field": "thing", "when": { "holds": [ "things" ] } },
            { "field": "client", "when": { "holds": [ "organisations" ] } }
          ],
          "order": [ { "field": "by", "dir": "asc" }, { "field": "priority", "dir": "asc" } ],
          "limit": 8,
          "when": { "metric": "tasks-late-yours", "gt": 0 }
        },
        {
          "kind": "todo",
          "heading": "Waiting on you",
          "icon": "hourglass",
          "span": 6,
          "source": "register.tasks",
          "where": "state is review or blocked",
          "columns": [
            { "field": "what" },
            { "field": "note" },
            { "field": "by" },
            { "field": "thing", "when": { "holds": [ "things" ] } }
          ],
          "order": [ { "field": "by", "dir": "asc" } ],
          "limit": 8,
          "when": { "metric": "tasks-waiting", "gt": 0 }
        },
        {
          "kind": "todo",
          "key": "k1e53uhc",
          "heading": "Your work this week",
          "icon": "calendar-days",
          "span": 6,
          "source": "register.tasks",
          "where": "state is open or doing, agent is empty, owner is not someone else, by after yesterday, by before +8d",
          "columns": [
            { "field": "what" },
            { "field": "by" },
            { "field": "thing", "when": { "holds": [ "things" ] } },
            { "field": "client", "when": { "holds": [ "organisations" ] } }
          ],
          "order": [ { "field": "by", "dir": "asc" }, { "field": "priority", "dir": "asc" } ],
          "limit": 8,
          "when": { "metric": "tasks-this-week-yours", "gt": 0 }
        },
        {
          "kind": "todo",
          "heading": "With an agent",
          "icon": "session",
          "span": 6,
          "source": "register.tasks",
          "where": "state is open or doing, agent is set",
          "columns": [
            { "field": "what" },
            { "field": "agent" },
            { "field": "by" },
            { "field": "thing", "when": { "holds": [ "things" ] } }
          ],
          "order": [ { "field": "by", "dir": "asc" } ],
          "limit": 8,
          "working": true,
          "when": { "metric": "tasks-with-agents", "gt": 0 }
        },
        {
          "kind": "section",
          "heading": "Not this week",
          "icon": "archive",
          "span": 12,
          "fold": true,
          "source": "register.tasks",
          "where": {
            "any": [
              {
                "all": [
                  { "field": "state", "in": [ "open", "doing" ] },
                  { "field": "agent", "empty": true },
                  { "any": [ { "field": "by", "after": "+7d" }, { "field": "by", "empty": true } ] }
                ]
              },
              { "field": "state", "is": "backlog" }
            ]
          },
          "when": { "metric": "tasks-not-this-week", "gt": 0 }
        },
        {
          "kind": "todo",
          "heading": "After this week",
          "icon": "calendar-days",
          "span": 12,
          "source": "register.tasks",
          "where": "state is open or doing, agent is empty, owner is not someone else, by after +7d",
          "columns": [
            { "field": "what" },
            { "field": "by" },
            { "field": "client", "when": { "holds": [ "organisations" ] } }
          ],
          "order": [ { "field": "by", "dir": "asc" } ],
          "limit": 8,
          "when": { "metric": "tasks-after-week-yours", "gt": 0 }
        },
        {
          "kind": "todo",
          "heading": "No due day",
          "icon": "circle-dashed",
          "span": 12,
          "source": "register.tasks",
          "where": "state is open or doing, agent is empty, owner is not someone else, by is empty",
          "columns": [
            { "field": "what" },
            { "field": "thing", "when": { "holds": [ "things" ] } },
            { "field": "client", "when": { "holds": [ "organisations" ] } }
          ],
          "order": [ { "field": "created_at", "dir": "desc" } ],
          "limit": 8,
          "when": { "metric": "tasks-undated-yours", "gt": 0 }
        },
        {
          "kind": "todo",
          "heading": "Later",
          "icon": "archive",
          "span": 12,
          "source": "register.tasks",
          "where": "state is backlog",
          "columns": [
            { "field": "what" },
            { "field": "thing", "when": { "holds": [ "things" ] } },
            { "field": "client", "when": { "holds": [ "organisations" ] } }
          ],
          "order": [ { "field": "by", "dir": "asc" }, { "field": "created_at", "dir": "desc" } ],
          "limit": 8,
          "when": { "metric": "tasks-later", "gt": 0 }
        },
        {
          "kind": "section",
          "heading": "Needs a project",
          "icon": "inbox",
          "span": 12,
          "fold": true,
          "source": "register.tasks",
          "where": "state is not backlog or done or dropped, thing is empty, client is empty",
          "when": { "metric": "tasks-no-project", "gt": 0 }
        },
        {
          "kind": "table",
          "heading": "With no project",
          "icon": "folder",
          "span": 12,
          "source": "register.tasks",
          "where": "state is not backlog or done or dropped, thing is empty, client is empty",
          "columns": [
            { "field": "what", "width": "minmax(20ch,1fr)" },
            { "field": "by", "label": "Due", "width": "13ch", "align": "end" }
          ],
          "order": [ { "field": "created_at", "dir": "desc" } ],
          "limit": 5,
          "when": { "holds": [ "things" ] }
        },
        {
          "kind": "section",
          "heading": "Not moved in three months",
          "icon": "hourglass",
          "span": 12,
          "fold": true,
          "source": "register.tasks",
          "where": "state is not backlog or done or dropped, updated_at before -90d"
        },
        {
          "kind": "table",
          "heading": "Untouched for 90 days",
          "icon": "hourglass",
          "span": 12,
          "source": "register.tasks",
          "where": "state is not backlog or done or dropped, updated_at before -90d",
          "columns": [
            { "field": "what", "width": "minmax(20ch,1fr)" },
            { "field": "by", "label": "Due", "width": "13ch", "align": "end" }
          ],
          "order": [ { "field": "updated_at", "dir": "asc" } ],
          "limit": 8
        },
        {
          "kind": "section",
          "heading": "Done lately",
          "icon": "check",
          "span": 12,
          "fold": true,
          "source": "register.tasks",
          "where": "state is done, done_on after -8d",
          "when": { "metric": "tasks-done-7d", "gt": 0 }
        },
        {
          "kind": "todo",
          "heading": "Done recently",
          "icon": "circle-check",
          "span": 12,
          "source": "register.tasks",
          "where": "state is done, done_on after -8d",
          "columns": [ { "field": "what" }, { "field": "done_on" }, { "field": "agent" } ],
          "order": [ { "field": "done_on", "dir": "desc" } ],
          "limit": 8,
          "when": { "metric": "tasks-done-7d", "gt": 0 }
        }
      ]
    },
    {
      "page": "work-board",
      "title": "Board",
      "nav": { "section": "Work", "order": 20 },
      "icon": "board",
      "requires": [ "register.tasks" ],
      "pack": "work",
      "blocks": [
        {
          "kind": "note",
          "lead": true,
          "span": 12,
          "when": { "metric": "open-tasks", "is": 0 },
          "body": "Nothing is open right now"
        },
        { "kind": "capture", "heading": "What needs doing?", "icon": "plus", "span": 12, "register": "tasks" },
        {
          "kind": "board",
          "span": 12,
          "columns": [
            { "field": "state" },
            { "field": "what" },
            { "field": "by" },
            { "field": "owner", "when": { "holds": [ "people" ] } }
          ],
          "source": "register.tasks",
          "where": "state is not dropped",
          "order": [
            { "field": "state", "dir": "asc" },
            { "field": "priority", "dir": "asc" },
            { "field": "by", "dir": "asc" }
          ],
          "limit": 100,
          "working": true
        }
      ]
    },
    {
      "page": "roadmap",
      "title": "Timeline",
      "nav": { "section": "Work", "order": 30 },
      "icon": "calendar",
      "requires": [ "register.tasks" ],
      "pack": "work",
      "blocks": [
        {
          "kind": "note",
          "lead": true,
          "span": 12,
          "when": { "metric": "tasks-dated", "is": 0 },
          "body": "No task has a due day yet. Give one a day on [Work](/p/work)."
        },
        {
          "kind": "roadmap",
          "key": "k0bndy4b",
          "heading": "Tasks by due day",
          "span": 12,
          "source": "register.tasks",
          "where": "by is set, state is not done or dropped",
          "columns": [
            { "field": "what", "label": "What" },
            { "field": "by", "label": "Due" },
            { "field": "effort", "label": "Effort" }
          ],
          "order": [ { "field": "by", "dir": "asc" } ],
          "limit": 200,
          "empty": "Each open task with a due day stands here on its day. Give a task a due day and it joins the line."
        }
      ]
    },
    {
      "metric": "project-open",
      "name": "Open",
      "source": "register.tasks",
      "where": "thing is {{it}}, state is not backlog or done or dropped",
      "value": { "count": "id" },
      "format": "int",
      "target": { "lte": 5 },
      "window": "30d",
      "compare": "none",
      "when": { "holds": [ "things" ] }
    },
    {
      "metric": "project-due-soon",
      "name": "Due soon",
      "source": "register.tasks",
      "where": "thing is {{it}}, state is not backlog or done or dropped, by after yesterday, by before +8d",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none",
      "when": { "holds": [ "things" ] }
    },
    {
      "metric": "project-in-review",
      "name": "In review",
      "source": "register.tasks",
      "where": "thing is {{it}}, state is review",
      "value": { "count": "id" },
      "format": "int",
      "target": { "lte": 0 },
      "window": "30d",
      "compare": "none",
      "when": { "holds": [ "things" ] }
    },
    {
      "metric": "project-held-up",
      "name": "Handed back or blocked",
      "source": "register.tasks",
      "where": "thing is {{it}}, state is review or blocked",
      "value": { "count": "id" },
      "format": "int",
      "target": { "lte": 0 },
      "window": "30d",
      "compare": "none",
      "when": { "holds": [ "things" ] }
    },
    {
      "metric": "project-moved-7d",
      "name": "Changed this week",
      "source": "register.tasks",
      "where": "thing is {{it}}, updated_at after -8d",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none",
      "when": { "holds": [ "things" ] }
    },
    {
      "metric": "project-last-worked",
      "name": "Last worked",
      "source": "register.tasks",
      "where": "thing is {{it}}",
      "value": { "age": "updated_at" },
      "format": "days",
      "target": { "lte": 30 },
      "window": "30d",
      "compare": "none",
      "when": { "holds": [ "things" ] }
    },
    {
      "metric": "project-done-7d",
      "name": "Done this week",
      "source": "register.tasks",
      "where": "thing is {{it}}, state is done, done_on after -8d",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none",
      "when": { "holds": [ "things" ] }
    },
    {
      "metric": "project-dated",
      "name": "Planned with a day",
      "source": "register.tasks",
      "where": "thing is {{it}}, by is set, state is not done or dropped",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none",
      "when": { "holds": [ "things" ] }
    },
    {
      "metric": "open-tasks",
      "name": "Open",
      "source": "register.tasks",
      "where": "state is not backlog or done or dropped",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none",
      "snapshot": { "grain": "day", "into": "series.open-tasks" }
    },
    {
      "metric": "tasks-in-play",
      "name": "Open",
      "source": "register.tasks",
      "where": "state is not done or dropped",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "tasks-later",
      "name": "Kept for later",
      "source": "register.tasks",
      "where": "state is backlog",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "tasks-due-7d",
      "name": "Due in 7 days",
      "source": "register.tasks",
      "where": "state is not done or dropped, by after yesterday, by before +8d",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "tasks-dated",
      "name": "Open tasks with a due day",
      "source": "register.tasks",
      "where": "by is set, state is not done or dropped",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "tasks-overdue",
      "name": "Past their date",
      "source": "register.tasks",
      "where": "state is not done or dropped, by before today",
      "value": { "count": "id" },
      "format": "int",
      "target": { "lte": 0 },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "tasks-late-yours",
      "name": "Yours, late",
      "source": "register.tasks",
      "where": "state is open or doing, agent is empty, owner is not someone else, by before today",
      "value": { "count": "id" },
      "format": "int",
      "target": { "lte": 0 },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "tasks-today-yours",
      "name": "Yours, due today",
      "source": "register.tasks",
      "where": "state is open or doing, agent is empty, owner is not someone else, by is today",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "tasks-week-yours",
      "name": "Yours, due this week",
      "source": "register.tasks",
      "where": "state is open or doing, agent is empty, owner is not someone else, by after today, by before +8d",
      "value": { "count": "id" },
      "format": "int",
