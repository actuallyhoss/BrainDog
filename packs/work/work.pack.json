    {
      "rule": "close_follow_ups",
      "pack": "work",
      "on": { "written": { "register": "tasks", "op": [ "update" ], "fields": [ "state" ] } },
      "when": "state is done",
      "steps": [ { "script": { "id": "close_follow_ups", "as": "closing" } } ]
    },
    {
      "rule": "start_with_parent",
      "pack": "work",
      "on": { "written": { "register": "tasks", "op": [ "create" ] } },
      "when": "parent is set",
      "steps": [ { "script": { "id": "start_with_parent", "as": "placing" } } ]
    },
    {
      "script": "close_follow_ups",
      "title": "Close the follow-ups of a finished task",
      "pack": "work",
      "runs": { "rule": true },
      "egress": [],
      "keys": [],
      "reads": [ "tasks" ],
      "writes": [ "tasks" ],
      "source": "export default async function run(ctx) {\n  const parent = await ctx.record.get(ctx.input.id);\n  if (!parent || parent.fields.state !== 'done') return;\n  const steps = await ctx.record.list('tasks', { all: [{ field: 'parent', is: parent.id }, { field: 'state', in: ['open', 'doing', 'blocked'] }] });\n  const line = 'Closed with ' + parent.fields.what + ' (tasks#' + parent.seq + ').';\n  for (const step of steps) {\n    const note = typeof step.fields.note === 'string' && step.fields.note.trim() !== '' ? step.fields.note + '\\n\\n' + line : line;\n    ctx.update('tasks#' + step.seq, { state: 'done', note }, step.version);\n  }\n}"
    },
    {
      "script": "start_with_parent",
      "title": "Start a follow-up where its parent is",
      "pack": "work",
      "runs": { "rule": true },
      "egress": [],
      "keys": [],
      "reads": [ "tasks" ],
      "writes": [ "tasks" ],
      "source": "export default async function run(ctx) {\n  const task = await ctx.record.get(ctx.input.id);\n  if (!task || !task.fields.parent) return;\n  const parent = await ctx.record.get(task.fields.parent);\n  if (!parent) return;\n  const patch = {};\n  for (const field of ['thing', 'track', 'owner'])\n    if (!task.fields[field] && parent.fields[field]) patch[field] = parent.fields[field];\n  const name = (v) => (typeof v === 'string' ? v.trim().toLowerCase() : '');\n  const by = ctx.input.made_by;\n  const maker = by !== null && typeof by === 'object' ? name(by.agent) : '';\n  if (!task.fields.agent && maker !== '' && maker !== 'other' && maker === name(parent.fields.agent)) patch.agent = parent.fields.agent;\n  if (Object.keys(patch).length > 0) ctx.update('tasks#' + task.seq, patch, task.version);\n}"
    }
  ],
  "seeds": [
