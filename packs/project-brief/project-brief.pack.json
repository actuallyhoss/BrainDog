{
  "pack": "project-brief",
  "version": "1.1.0",
  "title": "Project brief",
  "summary": "A line on what each project is, the plan for it, and what is in the way.",
  "author": "BrainDog",
  "license": "Apache-2.0",
  "requires": {
    "format": 1,
    "primitives": 1,
    "packs": {
      "portfolio": "^1.0.0"
    }
  },
  "extends": {
    "register.things": {
      "fields": [
        {
          "id": "summary",
          "label": "One line",
          "type": "text",
          "search": true
        },
        {
          "id": "plan",
          "label": "The plan",
          "type": "list",
          "of": "text"
        },
        {
          "id": "blockers",
          "label": "In the way",
          "type": "list",
          "of": "text"
        }
      ]
    }
  },
  "adds": [
    {
      "page": "page.project",
      "after": "Where it stands",
      "note": "The one line, the plan and what is in the way, on the project page itself, where the old tool shows them.",
      "block": {
        "kind": "cards",
        "heading": "The brief",
        "span": 12,
        "source": "register.things",
        "where": "name is {{name}}",
        "columns": [
          {
            "field": "summary",
            "label": "One line",
            "as": "title"
          },
          {
            "field": "plan",
            "label": "The plan",
            "as": "fact"
          },
          {
            "field": "blockers",
            "label": "In the way",
            "as": "fact"
          }
        ],
        "limit": 1,
        "empty": "Nobody has written a line, a plan or what is in the way for {{name}} yet."
      }
    }
  ],
  "declarations": [
    {
      "page": "briefs",
      "title": "Briefs",
      "nav": {
        "section": "Projects",
        "order": 20
      },
      "icon": "thing",
      "requires": [
        "register.things"
      ],
      "blocks": [
        {
          "kind": "table",
          "heading": "In the way",
          "span": 12,
          "source": "register.things",
          "where": "lane is building or earning, blockers is set",
          "columns": [
            {
              "field": "name",
              "label": "Project",
              "width": "minmax(14ch,1fr)"
            },
            {
              "field": "blockers",
              "label": "In the way",
              "width": "minmax(24ch,2fr)"
            }
          ],
          "order": [
            {
              "field": "name",
              "dir": "asc"
            }
          ],
          "limit": 50,
          "empty": "Nothing is in the way of a project in play."
        },
        {
          "kind": "table",
          "heading": "What each one is",
          "span": 12,
          "source": "register.things",
          "where": "lane is building or earning",
          "columns": [
            {
              "field": "name",
              "label": "Project",
              "width": "minmax(14ch,1fr)"
            },
            {
              "field": "summary",
              "label": "One line",
              "width": "minmax(24ch,2fr)"
            },
            {
              "field": "lane",
              "label": "Status",
              "width": "10ch"
            }
          ],
          "order": [
            {
              "field": "name",
              "dir": "asc"
            }
          ],
          "limit": 50,
          "empty": "No project is in play."
        },
        {
          "kind": "table",
          "heading": "The plan",
          "span": 12,
          "source": "register.things",
          "where": "lane is building or earning, plan is set",
          "columns": [
            {
              "field": "name",
              "label": "Project",
              "width": "minmax(14ch,1fr)"
            },
            {
              "field": "plan",
              "label": "The plan",
              "width": "minmax(24ch,2fr)"
            }
          ],
          "order": [
            {
              "field": "name",
              "dir": "asc"
            }
          ],
          "limit": 50,
          "empty": "No project in play has a plan written down."
        }
      ]
    }
  ]
}
