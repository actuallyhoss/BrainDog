{
  "pack": "people",
  "version": "3.5.0",
  "title": "People",
  "summary": "Clients, contractors and accountants, the organisations they are with, and where each one was seen.",
  "changes": "Health is said in plain words: how many checks have not run yet, Needs a look, All good and Not checked yet, and how many days every check has passed.",
  "author": "BrainDog",
  "license": "MIT",
  "requires": { "format": 1, "primitives": 1, "packs": {} },
  "words": { "people": { "name": "People", "one": "person" } },
  "declarations": [
    {
      "register": "people",
      "name": "People",
      "icon": "people",
      "one": "person",
      "holds": "collaborators, contractors and accountants, and what each one is for",
      "title": "name",
      "mobile": [ "name", "role", "rate" ],
      "pack": "people",
      "meets": {
        "name": "name",
        "email": "email",
        "handles": "handles",
        "projects": "projects",
        "met": "met",
        "merged_into": "merged_into",
        "in_touch": "in_touch",
        "keys": "keys",
        "org": "org",
        "self": "self",
        "aliases": "aliases"
      },
      "delete": "refuse_while_referenced",
      "fields": [
        { "id": "name", "type": "text", "required": true, "search": true },
        {
          "id": "role",
          "type": "enum",
          "values": [ "client", "contractor", "accountant", "collaborator", "other" ],
          "index": true
        },
        { "id": "rate", "type": "money" },
        { "id": "email", "type": "email", "unique": true, "index": true },
        { "id": "org", "label": "Organisation", "type": "ref", "to": "organisations", "index": true },
        { "id": "note", "type": "text" },
        { "id": "keys", "label": "Known by", "type": "list", "of": "text" },
        { "id": "aliases", "label": "Also called", "type": "list", "of": "text" },
        { "id": "self", "label": "This is you", "type": "bool", "default": false },
        { "id": "handles", "label": "Handles", "type": "list", "of": "text" },
        {
          "id": "projects",
          "label": "Met in",
          "type": "list",
          "of": "ref",
          "to": "things",
          "scope": { "links": true },
          "when": { "holds": [ "things" ] }
        },
        { "id": "met", "label": "Met", "type": "list", "of": "text" },
        { "id": "merged_into", "label": "Merged into", "type": "ref", "to": "people" },
        { "id": "in_touch", "label": "Last in touch", "type": "day", "index": true },
        { "id": "tags", "type": "list", "of": "text" }
      ]
    },
    {
      "register": "organisations",
      "name": "Organisations",
      "icon": "grid",
      "one": "organisation",
      "holds": "the companies, clients, vendors, shops and banks you deal with, and the projects each is part of",
      "title": "name",
      "mobile": [ "name", "kind", "domain" ],
      "pack": "people",
      "org": {
        "name": "name",
        "keys": "keys",
        "kind": "kind",
        "domain": "domain",
        "merged_into": "merged_into",
        "met": "met",
        "projects": "projects"
      },
      "delete": "refuse_while_referenced",
      "fields": [
        { "id": "name", "label": "Organisation", "type": "text", "required": true, "search": true },
        {
          "id": "kind",
          "label": "Kind",
          "type": "enum",
          "values": [ "company", "employer", "client", "vendor", "merchant", "bank", "other" ],
          "labels": {
            "company": "Company",
            "employer": "Employer",
            "client": "Client",
            "vendor": "Vendor",
            "merchant": "Shop",
            "bank": "Bank",
            "other": "Other"
          },
          "index": true
        },
        { "id": "domain", "label": "Website", "type": "text", "index": true },
        { "id": "keys", "label": "Known by", "type": "list", "of": "text" },
        {
          "id": "projects",
          "label": "Projects",
          "type": "list",
          "of": "ref",
          "to": "things",
          "scope": { "links": true },
          "when": { "holds": [ "things" ] }
        },
        { "id": "met", "label": "Seen in", "type": "list", "of": "text" },
        { "id": "merged_into", "label": "Merged into", "type": "ref", "to": "organisations" },
        { "id": "note", "label": "Notes", "type": "document" },
        { "id": "tags", "type": "list", "of": "text" }
      ]
    },
    {
      "page": "people",
      "title": "People",
      "nav": { "section": "People", "order": 10, "place": 50 },
      "icon": "people",
      "requires": [ "register.people", "register.organisations" ],
      "blocks": [
        {
          "kind": "note",
          "lead": true,
          "span": 12,
          "when": { "metric": "people-quiet", "is": 0 },
          "body": "{{questions-open-in:people}} question(s) for you, {{people-count}} contact(s)"
        },
        {
          "kind": "note",
          "lead": true,
          "span": 12,
          "when": { "metric": "people-quiet", "gt": 0 },
          "body": "{{questions-open-in:people}} question(s) for you, {{people-quiet.first}} has been quiet since {{people-quiet.since}}, and {{people-quiet.more}} other(s) have too"
        },
        {
          "kind": "queue",
          "heading": "Waiting on you",
          "icon": "ask",
          "span": 12,
          "source": "governance.open",
          "where": "list is people",
          "limit": 3,
          "when": { "metric": "questions-open-in:people", "gt": 0 }
        },
        {
          "kind": "note",
          "span": 12,
          "when": { "metric": "held-twice", "gt": 0 },
          "body": "{{held-twice-shown}} people may be on this record twice, {{held-twice}} too many. [See them](/r/people?twice=1)."
        },
        {
          "kind": "table",
          "heading": "Everyone",
          "icon": "people",
          "span": 6,
          "source": "register.people",
          "where": "merged_into is empty",
          "columns": [
            { "field": "name", "label": "Name", "width": "minmax(14ch,2fr)" },
            { "field": "role", "label": "Role", "width": "12ch" },
            { "field": "in_touch", "label": "Last spoke", "width": "14ch", "align": "end" }
          ],
          "order": [ { "field": "in_touch", "dir": "desc" }, { "field": "seq", "dir": "desc" } ],
          "limit": 50,
          "empty": "Nobody yet. Add someone, or an agent adds whoever it meets in a commit or a mail."
        },
        {
          "kind": "table",
          "heading": "Organisations",
          "icon": "building",
          "span": 6,
          "source": "register.organisations",
          "where": "merged_into is empty",
          "when": { "metric": "organisations-count", "gt": 0 },
          "columns": [
            { "field": "name", "label": "Organisation", "width": "minmax(14ch,2fr)" },
            { "field": "kind", "label": "Kind", "width": "10ch" }
          ],
          "order": [ { "field": "name", "dir": "asc" } ]
        },
        {
          "kind": "agents",
          "heading": "What agents did",
          "icon": "activity",
          "span": 12,
          "source": "activity",
          "where": "list is people or organisations",
          "first": 3
        }
      ]
    },
    {
      "page": "someone",
      "title": "{{name}}",
      "for": { "register": "people" },
      "icon": "people",
      "pack": "people",
      "requires": [ "register.people" ],
      "blocks": [
        {
          "kind": "cards",
          "lead": true,
          "span": 12,
          "source": "register.people",
          "where": "name is {{name}}",
          "columns": [
            { "field": "name", "label": "Name", "as": "who" },
            { "field": "role", "label": "Role", "as": "fact" },
            { "field": "org", "label": "Organisation", "as": "fact" },
            { "field": "projects", "label": "Met in", "as": "fact", "when": { "holds": [ "things" ] } },
            { "field": "in_touch", "label": "Last in touch", "as": "when" }
          ],
          "limit": 1,
          "empty": "Nothing is kept about {{name}} yet."
        },
        {
          "kind": "note",
          "heading": "Seen in",
          "icon": "handshake",
          "span": 12,
          "body": "{{met}}",
          "empty": "Nothing is kept about where {{name}} was seen yet."
        },
        {
          "kind": "note",
          "document": true,
          "heading": "Notes",
          "icon": "doc",
          "span": 12,
          "body": "{{note}}",
          "empty": "Nothing is written about {{name}} yet."
        }
      ]
    },
    {
      "page": "relation",
      "title": "{{name}}",
      "for": { "register": "organisations" },
      "icon": "grid",
      "pack": "people",
      "requires": [ "register.organisations", "register.people", "register.things", "register.transactions" ],
      "blocks": [
        {
          "kind": "cards",
          "lead": true,
          "span": 12,
          "source": "register.organisations",
          "where": "name is {{name}}",
          "columns": [
            { "field": "name", "label": "Organisation", "as": "who" },
            { "field": "kind", "label": "Kind", "as": "fact" },
            { "field": "domain", "label": "Website", "as": "fact" }
          ],
          "limit": 1,
          "empty": "Nothing is kept about {{name}} yet."
        },
        {
          "kind": "cards",
          "heading": "People",
          "icon": "people",
          "span": 12,
          "source": "register.people",
          "where": "org is {{name}}, merged_into is empty",
          "columns": [
            { "field": "name", "label": "Name", "as": "who" },
            { "field": "role", "label": "Role", "as": "fact" },
            { "field": "in_touch", "label": "Last in touch", "as": "when" }
          ],
          "order": [ { "field": "in_touch", "dir": "desc" }, { "field": "seq", "dir": "desc" } ],
          "empty": "Nobody here is known to be with {{name}} yet."
        },
        {
          "kind": "cards",
          "heading": "Projects",
          "icon": "thing",
          "span": 12,
          "source": "register.things",
          "where": "id is {{projects}}",
          "columns": [ { "field": "name", "as": "title" }, { "field": "next", "label": "Next step", "as": "fact" } ],
          "limit": 8,
          "when": { "holds": [ "things" ] }
        },
        {
          "kind": "timeline",
          "heading": "Money",
          "icon": "receipt",
          "span": 12,
          "source": "register.transactions",
          "where": "state is not void, party is {{name}}",
          "columns": [
            { "field": "on" },
            { "field": "what" },
            { "field": "amount", "sign": { "field": "direction", "minus": "out" } }
          ],
          "order": [ { "field": "on", "dir": "desc" } ],
          "limit": 8,
          "when": { "holds": [ "transactions" ] }
        },
        {
          "kind": "note",
          "heading": "Seen in",
          "icon": "handshake",
          "span": 12,
          "body": "{{met}}",
          "empty": "Nothing is kept about where {{name}} was seen yet."
        },
        {
          "kind": "note",
          "document": true,
          "heading": "Notes",
          "icon": "doc",
          "span": 12,
          "body": "{{note}}",
          "empty": "Nothing is written about {{name}} yet."
        }
      ]
    },
    {
      "page": "health",
      "title": "Health",
      "icon": "heart-pulse",
      "pack": "people",
      "blocks": [
        {
          "kind": "note",
          "lead": true,
          "span": 12,
          "when": { "metric": "signs-red", "is": 0 },
          "body": "Nothing on this record needs a look."
        },
        {
          "kind": "note",
          "lead": true,
          "span": 12,
          "when": { "metric": "signs-red", "is": 1 },
          "body": "One thing on this record needs a look."
        },
        {
          "kind": "note",
          "lead": true,
          "span": 12,
          "when": { "metric": "signs-red", "gt": 1 },
          "body": "{{signs-red}} things on this record need a look."
        },
        {
          "kind": "note",
          "span": 12,
          "when": { "metric": "signs-unread", "is": 1 },
          "body": "One check has not run yet."
        },
        {
          "kind": "note",
          "span": 12,
          "when": { "metric": "signs-unread", "gt": 1 },
          "body": "{{signs-unread}} checks have not run yet."
        },
        {
          "kind": "cards",
          "heading": "Needs a look",
          "icon": "octagon-alert",
          "span": 12,
          "source": "signs",
          "where": "state is red",
          "columns": [ { "field": "name", "as": "title" }, { "field": "said", "as": "reply" } ]
        },
        {
          "kind": "cards",
          "heading": "All good",
          "icon": "circle-check",
          "span": 12,
          "source": "signs",
          "where": "state is green",
          "columns": [ { "field": "name", "as": "title" }, { "field": "said", "as": "reply" } ]
        },
        {
          "kind": "cards",
          "heading": "Not checked yet",
          "icon": "circle-dashed",
          "span": 12,
          "source": "signs",
          "where": "state is none",
          "columns": [ { "field": "name", "as": "title" }, { "field": "said", "as": "reply" } ]
        },
        {
          "kind": "note",
          "span": 12,
          "when": { "metric": "green-days", "is": 1 },
          "body": "Every check passed yesterday."
        },
        {
          "kind": "note",
          "span": 12,
          "when": { "metric": "green-days", "gt": 1 },
          "body": "Every check has passed for {{green-days}} days, up to yesterday."
        }
      ]
    },
    {
      "page": "calendar",
      "title": "Calendar",
      "icon": "calendar",
      "pack": "people",
      "blocks": [
        {
          "kind": "note",
          "lead": true,
          "span": 12,
          "body": "Everything with a day it is due, this month and the next two."
        },
        {
          "kind": "calendar",
          "span": 12,
          "source": "deadlines",
          "columns": [ { "field": "title" }, { "field": "day" } ],
          "back": 0,
          "ahead": 2,
          "empty": "Nothing is due in these three months."
        }
      ]
    },
    {
      "page": "activity",
      "title": "Activity",
      "icon": "activity",
      "pack": "people",
      "layout": { "rail": 4 },
      "filters": [
        { "field": "who", "control": "chips" },
        { "field": "kind", "control": "chips" },
        { "field": "list", "control": "chips" }
      ],
      "blocks": [
        {
          "kind": "note",
          "lead": true,
          "key": "line",
          "span": 12,
          "body": "Everything that changed, a day at a time, newest first."
        },
        {
          "kind": "feed",
          "key": "feed",
          "span": 12,
          "source": "activity",
          "group": "day",
          "fold": "run",
          "since": "seen",
          "first": 50,
          "empty": "Nothing has changed yet."
        },
        {
          "kind": "split",
          "key": "who-worked",
          "heading": "Who worked",
          "icon": "people",
          "span": 12,
          "area": "rail",
          "source": "metric.activity-by-who"
        },
        {
          "kind": "bar",
          "key": "what-changed",
          "heading": "What changed",
          "icon": "activity",
          "span": 12,
          "area": "rail",
          "source": "metric.activity-by-kind"
        },
        {
          "kind": "bar",
          "key": "busy-hours",
          "heading": "Busy hours",
          "icon": "clock",
          "span": 12,
          "area": "rail",
          "source": "metric.activity-by-hour"
        },
        {
          "kind": "queue",
          "key": "agents-asked",
          "heading": "Agents asked",
          "icon": "ask",
          "span": 12,
          "area": "rail",
          "source": "governance.open",
          "where": {
            "any": [
              { "field": "who", "starts": "agent:" },
              { "field": "who", "starts": "s1" },
              { "field": "who", "starts": "s2" },
              { "field": "who", "starts": "s3" },
              { "field": "who", "starts": "s4" },
              { "field": "who", "starts": "s5" },
              { "field": "who", "starts": "s6" },
              { "field": "who", "starts": "s7" },
              { "field": "who", "starts": "s8" },
              { "field": "who", "starts": "s9" }
            ]
          },
          "limit": 3,
          "when": { "metric": "questions-open", "gt": 0 }
        }
      ]
    },
    {
      "metric": "people-count",
      "name": "People",
      "source": "register.people",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "people-in-touch-30d",
      "name": "In touch, 30 days",
      "source": "register.people",
      "where": "in_touch after -31d",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none",
      "snapshot": { "grain": "day", "into": "series.people-in-touch-30d" }
    },
    {
      "metric": "people-in-touch-12w",
      "name": "In touch, 12 weeks",
      "source": "register.people",
      "where": "in_touch after -84d",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "people-in-touch-90d",
      "name": "In touch, 3 months",
      "source": "register.people",
      "where": "in_touch after -91d",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "organisations-count",
      "name": "Organisations",
      "source": "register.organisations",
      "where": "merged_into is empty",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "people-quiet",
      "name": "Quiet for three months",
      "source": "register.people",
      "where": "in_touch before -90d",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none"
    },
    {
      "rule": "meet-senders",
      "name": "Note whoever writes in",
      "pack": "people",
      "on": { "arrival": { "channel": "email", "state": [ "untriaged" ] } },
      "steps": [
        { "set_var": { "name": "sender", "to": "{{trigger.body.from_address}}" } },
        {
          "if": {
            "none": [
              { "field": "sender", "empty": true },
              { "field": "sender", "contains": "noreply" },
              { "field": "sender", "contains": "no-reply" },
              { "field": "sender", "contains": "donotreply" },
              { "field": "sender", "contains": "do-not-reply" },
              { "field": "sender", "contains": "mailer-daemon" }
            ]
          },
          "then": [
            {
              "meet": {
                "name": "{{trigger.body.from_name}}",
                "email": "{{trigger.body.from_address}}",
                "only": "known",
                "where": "mail from {{trigger.body.from_domain}}",
                "source": "mail from {{trigger.body.from_domain}}"
              }
            }
          ]
        }
      ]
    },
    {
      "rule": "meet-sender-organisations",
      "name": "Know who sends the mail a pattern reads",
      "pack": "people",
      "on": { "arrival": { "channel": "email", "state": [ "matched", "review", "proposed", "skipped" ] } },
      "steps": [
        { "set_var": { "name": "domain", "to": "{{trigger.body.from_domain}}" } },
        {
          "if": {
            "none": [
              { "field": "domain", "empty": true },
              {
                "field": "domain",
                "in": [
                  "gmail.com",
                  "googlemail.com",
                  "icloud.com",
                  "me.com",
                  "mac.com",
                  "msn.com",
                  "live.com",
                  "live.co.uk",
                  "live.fr",
                  "proton.me",
                  "pm.me",
                  "mail.com",
                  "email.com",
                  "zoho.com",
                  "fastmail.com",
                  "hey.com",
                  "tutanota.com",
                  "tuta.io",
                  "qq.com",
                  "163.com",
                  "126.com",
                  "sina.com",
                  "naver.com",
                  "daum.net",
                  "mail.ru",
                  "inbox.ru",
                  "list.ru",
                  "bk.ru",
                  "web.de",
                  "t-online.de",
                  "laposte.net",
                  "libero.it",
                  "btinternet.com",
                  "virginmedia.com",
                  "att.net",
                  "verizon.net",
                  "sbcglobal.net",
                  "seznam.cz",
                  "wp.pl",
                  "o2.pl",
                  "users.noreply.github.com"
                ]
              },
              { "field": "domain", "starts": "yahoo." },
              { "field": "domain", "starts": "ymail." },
              { "field": "domain", "starts": "rocketmail." },
              { "field": "domain", "starts": "hotmail." },
              { "field": "domain", "starts": "outlook." },
              { "field": "domain", "starts": "aol." },
              { "field": "domain", "starts": "gmx." },
              { "field": "domain", "starts": "yandex." },
              { "field": "domain", "starts": "rambler." },
              { "field": "domain", "starts": "protonmail." },
              { "field": "domain", "starts": "rediffmail." }
            ]
          },
          "then": [
            {
              "meet": {
                "kind": "organisation",
                "domain": "{{trigger.body.from_domain}}",
                "name": "{{trigger.body.from_name}}",
                "where": "mail from {{trigger.body.from_domain}}",
                "source": "mail from {{trigger.body.from_domain}}"
              }
            }
          ]
        }
      ]
    },
    {
      "rule": "meet-payees",
      "name": "Know who each payment was with",
      "pack": "people",
      "on": { "arrival": { "state": [ "matched", "review", "proposed" ] } },
      "steps": [
        { "set_var": { "name": "payee", "to": "{{trigger.counterparty}}" } },
        {
          "if": { "none": [ { "field": "payee", "contains": "@" } ] },
          "then": [
            {
              "meet": {
                "kind": "organisation",
                "name": "{{trigger.counterparty}}",
                "keys": [ "bank:{{trigger.counterparty}}" ],
                "where": "bank text",
                "source": "bank text"
              }
            }
          ]
        }
      ]
    }
  ],
  "seeds": [
    {
      "register": "organisations",
      "fields": {
        "name": "Halden Type Co",
        "kind": "client",
        "domain": "halden.example",
        "keys": [ "domain:halden.example" ],
        "note": "Pays on 45 days, always.",
        "met": [ "2026-08-28 · mail from halden.example" ]
      }
    },
    {
