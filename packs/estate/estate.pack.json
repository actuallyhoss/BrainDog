{
  "pack": "estate",
  "version": "2.9.0",
  "title": "Services",
  "summary": "Domains, hosting, subscriptions, memberships, insurance and bills, and when each one renews.",
  "changes": "Services opens on what it costs a month, without counting the questions Waiting on you shows.",
  "author": "BrainDog",
  "license": "MIT",
  "requires": { "format": 1, "primitives": 1, "packs": {} },
  "words": { "services": { "name": "Services", "one": "service" } },
  "config": {
    "most_renewing_30d": { "type": "number", "label": "Most renewing in 30 days", "note": "Held to this as soon as it is saved." },
    "most_lapsing": { "type": "number", "label": "Most lapsing at once", "note": "Held to this as soon as it is saved." },
    "most_a_month": {
      "type": "money",
      "label": "Most to keep everything running a month",
      "note": "Held to this as soon as it is saved."
    },
    "most_a_year": {
      "type": "money",
      "label": "Most to keep everything running a year",
      "note": "Held to this as soon as it is saved."
    },
    "most_a_year_on_a_project": {
      "type": "money",
      "label": "Most a year to keep one project running",
      "note": "Held to this as soon as it is saved."
    }
  },
  "declarations": [
    {
      "register": "services",
      "icon": "service",
      "name": "Services",
      "one": "service",
      "holds": "a renewal date, who it is with and a cost, so you are told what renews before it does",
      "title": "name",
      "mobile": [ "name", "cost", "renews" ],
      "state": "state",
      "done": [ "cancelled" ],
      "pack": "estate",
      "fields": [
        { "id": "name", "type": "text", "required": true, "search": true },
        { "id": "provider", "type": "text", "index": true, "search": true },
        {
          "id": "kind",
          "label": "Type",
          "type": "enum",
          "values": [
            "domain",
            "hosting",
            "saas",
            "certificate",
            "subscription",
            "membership",
            "insurance",
            "utility",
            "server",
            "database",
            "storage",
            "network",
            "vm",
            "edge",
            "object"
          ],
          "labels": {
            "domain": "Domain",
            "hosting": "Hosting",
            "saas": "Software",
            "certificate": "Certificate",
            "subscription": "Subscription",
            "membership": "Membership",
            "insurance": "Insurance",
            "utility": "Utility",
            "server": "Server",
            "database": "Database",
            "storage": "Storage",
            "network": "Network",
            "vm": "Virtual machine",
            "edge": "Edge network",
            "object": "Object storage"
          },
          "index": true,
          "required": true
        },
        { "id": "renews", "type": "day", "index": true, "deadline": true, "remind": [ "-30d", "-7d", "0d" ] },
        { "id": "cost", "type": "money" },
        {
          "id": "cycle",
          "qualifies": "cost",
          "type": "enum",
          "values": [ "monthly", "yearly", "two_yearly" ],
          "index": true,
          "required": true
        },
        {
          "id": "state",
          "label": "Status",
          "type": "enum",
          "values": [ "live", "lapsing", "cancelled" ],
          "index": true,
          "required": true
        },
        { "id": "points_at", "label": "Points at", "type": "text" },
        {
          "id": "thing",
          "label": "Project",
          "type": "ref",
          "to": "things",
          "index": true,
          "when": { "holds": [ "things" ] }
        },
        { "id": "note", "type": "text" },
        { "id": "tags", "type": "list", "of": "text" }
      ]
    },
    {
      "page": "estate",
      "title": "Services",
      "nav": { "section": "Services", "order": 10 },
      "icon": "calendar",
      "requires": [ "register.services" ],
      "pack": "estate",
      "blocks": [
        {
          "kind": "note",
          "lead": true,
          "span": 12,
          "body": "{{estate-month}} a month to keep everything running."
        },
        {
          "kind": "note",
          "heading": "Nothing kept yet",
          "icon": "server",
          "span": 12,
          "body": "Add a domain, hosting or a subscription, and what it costs a month and when it renews show here.",
          "when": { "metric": "services-held", "lt": 1 }
        },
        {
          "kind": "table",
          "heading": "Points at nothing",
          "icon": "circle-alert",
          "span": 12,
          "source": "register.services",
          "where": "kind is domain, state is live, points_at is empty",
          "columns": [ { "field": "name" }, { "field": "provider" }, { "field": "renews" }, { "field": "cost" } ],
          "order": [ { "field": "renews", "dir": "asc" } ],
          "limit": 6,
          "when": { "metric": "points-nowhere", "gt": 0 }
        },
        {
          "kind": "table",
          "heading": "Lapsing",
          "icon": "circle-alert",
          "span": 12,
          "source": "register.services",
          "where": "state is lapsing",
          "columns": [
            { "field": "name" },
            { "field": "provider" },
            { "field": "renews", "label": "Lapses" },
            { "field": "note", "label": "Why" }
          ],
          "order": [ { "field": "renews", "dir": "asc" } ],
          "limit": 6,
          "when": { "metric": "lapsing", "gt": 0 }
        },
        {
          "kind": "queue",
          "heading": "Waiting on you",
          "icon": "ask",
          "span": 12,
          "source": "governance.open",
          "where": "list is services",
          "limit": 3,
          "when": { "metric": "questions-open-in:services", "gt": 0 }
        },
        {
          "kind": "split",
          "heading": "Each month, by type",
          "icon": "chart-pie",
          "span": 12,
          "source": "metric.estate-month-by-kind",
          "limit": 6,
          "when": { "metric": "estate-month", "gt": 0 },
          "empty": "Nothing to pay for yet."
        },
        {
          "kind": "timeline",
          "heading": "Next ninety days",
          "icon": "calendar-clock",
          "span": 12,
          "where": "state is not cancelled, renews after yesterday, renews before +90d",
          "columns": [ { "field": "renews" }, { "field": "name" }, { "field": "cost" } ],
          "source": "register.services",
          "order": [ { "field": "renews", "dir": "asc" } ],
          "limit": 8,
          "when": { "metric": "renews-90d", "gt": 0 },
          "empty": "Nothing renews in the next ninety days."
        },
        {
          "kind": "section",
          "heading": "Everything you keep",
          "icon": "archive",
          "span": 12,
          "fold": true,
          "when": { "metric": "services-held", "gt": 0 }
        },
        {
          "kind": "params",
          "heading": "What each domain points at",
          "icon": "globe",
          "span": 12,
          "columns": [ { "field": "name" }, { "field": "points_at" }, { "field": "provider" } ],
          "source": "register.services",
          "where": "kind is domain",
          "order": [ { "field": "name", "dir": "asc" } ],
          "limit": 6,
          "when": { "metric": "domains-held", "gt": 0 },
          "empty": "No domains."
        },
        {
          "kind": "table",
          "heading": "Everything",
          "icon": "rows",
          "span": 12,
          "source": "register.services",
          "columns": [
            { "field": "name", "label": "Name", "width": "minmax(16ch,1fr)" },
            { "field": "provider", "label": "Provider", "width": "minmax(12ch,18ch)" },
            { "field": "kind", "label": "Type", "width": "13ch" },
            { "field": "cost", "label": "Cost", "width": "13ch", "align": "end" },
            { "field": "renews", "label": "Renews", "width": "15ch", "align": "end" }
          ],
          "order": [ { "field": "renews", "dir": "asc" } ],
          "empty": "No services yet.",
          "limit": 50,
          "when": { "metric": "services-held", "gt": 0 }
        },
        {
          "kind": "agents",
          "heading": "What agents did",
          "icon": "activity",
          "span": 12,
          "source": "activity",
          "where": "list is services",
          "first": 3
        }
      ]
    },
    {
      "page": "service",
      "title": "{{name}}",
      "for": { "register": "services", "fleeting": true },
      "icon": "service",
      "requires": [ "register.services" ],
      "pack": "estate",
      "blocks": [
        {
          "kind": "cards",
          "lead": true,
          "span": 12,
          "source": "register.services",
          "where": "seq is {{seq}}, cost is set",
          "columns": [
            { "field": "name", "as": "title" },
            { "field": "cost", "label": "Next renewal", "as": "figure" },
            { "field": "provider", "label": "With", "as": "fact" },
            { "field": "points_at", "label": "Points at", "as": "fact" },
            { "field": "renews", "label": "Renews", "as": "when" }
          ],
          "limit": 1
        },
        {
          "kind": "cards",
          "lead": true,
          "span": 12,
          "source": "register.services",
          "where": "seq is {{seq}}, cost is empty",
          "columns": [
            { "field": "name", "as": "title" },
            { "field": "provider", "label": "With", "as": "fact" },
            { "field": "points_at", "label": "Points at", "as": "fact" },
            { "field": "renews", "label": "Renews", "as": "when" }
          ],
          "limit": 1
        },
        {
          "kind": "note",
          "heading": "Keys",
          "icon": "key",
          "span": 12,
          "body": "Keys for {{name}} are kept in the [Keychain](/keychain?q={{name}})."
        }
      ]
    },
    {
      "metric": "renews-30d",
      "name": "Renews in 30 days",
      "source": "register.services",
      "where": "state is not cancelled, renews after yesterday, renews before +31d",
      "value": { "count": "id" },
      "format": "int",
      "target": { "setting": "most_renewing_30d" },
      "window": "30d",
      "home": 3
    },
    {
      "metric": "lapsing",
      "name": "Lapsing",
      "source": "register.services",
      "where": "state is lapsing",
      "value": { "count": "id" },
      "format": "int",
      "target": { "setting": "most_lapsing" },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "estate-month",
      "name": "Cost per month",
      "source": "register.services",
      "where": "state is not cancelled",
      "value": { "sum": { "product": [ "cost", { "lookup": "per_month", "by": "cycle" } ] } },
      "lookups": { "per_month": { "monthly": 1, "yearly": 0.08333333333333333, "two_yearly": 0.041666666666666664 } },
      "format": "money",
      "target": { "setting": "most_a_month" },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "estate-month-by-kind",
      "name": "Cost per month, by type",
      "source": "register.services",
      "where": "state is not cancelled",
      "value": { "sum": { "product": [ "cost", { "lookup": "per_month", "by": "cycle" } ] } },
      "lookups": { "per_month": { "monthly": 1, "yearly": 0.08333333333333333, "two_yearly": 0.041666666666666664 } },
      "group_by": "kind",
      "format": "money",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "points-nowhere",
      "name": "Points at nothing",
      "source": "register.services",
      "where": "kind is domain, state is live, points_at is empty",
      "value": { "count": "id" },
      "format": "int",
      "target": { "lte": 0 },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "renews-90d",
      "name": "Renews in 90 days",
      "source": "register.services",
      "where": "state is not cancelled, renews after yesterday, renews before +90d",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "domains-held",
      "name": "Domains",
      "source": "register.services",
      "where": "kind is domain",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "services-held",
      "name": "Services",
      "source": "register.services",
      "value": { "count": "id" },
      "format": "int",
      "target": { "gte": 0 },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "estate-year",
      "name": "Cost per year",
      "source": "register.services",
      "where": "state is not cancelled",
      "value": { "sum": { "product": [ "cost", { "lookup": "per_year", "by": "cycle" } ] } },
      "lookups": { "per_year": { "monthly": 12, "yearly": 1, "two_yearly": 0.5 } },
      "format": "money",
      "target": { "setting": "most_a_year" },
      "window": "90d",
      "compare": "none"
    },
    {
      "metric": "project-cost",
      "name": "Costs a year",
      "source": "register.services",
      "where": "thing is {{it}}, state is not cancelled, cost is set",
      "value": { "sum": { "product": [ "cost", { "lookup": "per_year", "by": "cycle" } ] } },
      "lookups": { "per_year": { "monthly": 12, "yearly": 1, "two_yearly": 0.5 } },
      "format": "money",
      "target": { "setting": "most_a_year_on_a_project" },
      "window": "90d",
      "compare": "none",
      "when": { "holds": [ "things" ] }
    },
    {
      "rule": "renewal-passed",
      "name": "Mark a service lapsing once its renewal day has passed",
      "pack": "estate",
      "register": "services",
      "when": "state is live, renews before today",
      "then": [
        { "move": "lapsing" },
        {
          "notify": { "say": "{{name}} was due to renew {{ago:renews}} and nobody said it did, so it is lapsing." }
        }
      ],
      "once_per": [ "entry", "renews" ]
    },
    {
      "rule": "renew-soon",
      "name": "Ask whether to keep a service before it renews",
      "pack": "estate",
      "register": "services",
      "when": "state is live, cost more than 0, renews after yesterday, renews before +15d",
      "then": [
        {
          "suggest": {
            "question": "{{name}} renews {{until:renews}} for {{money:cost}}. Keep it?",
            "options": [ "Keep it", "Cancel it" ]
          }
        }
      ],
      "once_per": [ "entry", "renews" ]
    },
    {
      "rule": "renewal-kept",
      "name": "Keep a service live, and leave its next renewal day to you",
      "pack": "estate",
      "on": { "decided": { "about": "rule.renew-soon", "option": "Keep it" } },
      "steps": [
        { "move": "live" },
        { "note": "You chose to keep this in Needs you. Set the day it renews next once it has." }
      ]
    },
    {
      "rule": "renewal-cancelled",
      "name": "Mark a service cancelled, and leave telling the provider to you",
      "pack": "estate",
      "on": { "decided": { "about": "rule.renew-soon", "option": "Cancel it" } },
      "steps": [
        { "move": "cancelled" },
        { "note": "You chose to cancel this in Needs you. Cancel it with the provider too." }
      ]
    }
  ],
  "seeds": [
    {
      "register": "services",
      "fields": {
        "name": "kiln.example",
        "provider": "Nordhaven Registry",
        "kind": "domain",
        "renews": { "day": "+12" },
        "cost": { "amount": 1400, "currency": "GBP" },
        "cycle": "yearly",
        "state": "live",
        "points_at": "Pages"
      }
    }
  ]
}
