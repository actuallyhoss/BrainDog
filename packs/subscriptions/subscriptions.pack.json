          "values": [
            "often",
            "sometimes",
            "hardly",
            "never"
          ],
          "labels": {
            "often": "Often",
            "sometimes": "Now and then",
            "hardly": "Hardly",
            "never": "Not at all"
          }
        },
        {
          "id": "price_was",
          "label": "Price before",
          "type": "money"
        },
        {
          "id": "price_up_on",
          "label": "Went up on",
          "type": "day"
        },
        {
          "id": "price_seen",
