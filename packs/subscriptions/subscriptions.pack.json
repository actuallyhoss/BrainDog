{
  "pack": "subscriptions",
  "version": "1.3.0",
  "icon": "refresh",
  "title": "Subscriptions",
  "summary": "Everything you pay for on a cadence, in one place: what it costs a month and a year, what renews in the next 30 days, free trials about to end, the day to cancel by, a price that went up, and what you hardly use. Built on Repeating, so Cash ahead and Coming up already count them.",
  "changes": "Subscriptions opens on one line and the box to add one when nothing is marked yet, and What they cost shows what they cost a month and a year, leaving the counts to the lists under it that already say them.",
  "author": "BrainDog",
  "license": "Apache-2.0",
  "requires": {
    "format": 1,
    "primitives": 1,
    "packs": {
      "money-core": ">=3.0.0 <4.0.0"
    }
  },
