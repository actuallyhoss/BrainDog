  "declarations": [
    {
      "rule": "subscriptions_price",
      "name": "Keep a subscription's old price when its amount changes",
      "pack": "subscriptions",
      "on": {
        "written": {
          "register": "recurring",
          "op": [
            "create",
            "update"
          ],
          "fields": [
            "amount",
            "subscription"
          ]
        }
      },
      "when": "subscription is true",
      "steps": [
        {
          "script": {
            "id": "subscriptions_price",
            "as": "pricing"
          }
        }
      ]
    },
    {
      "script": "subscriptions_price",
      "title": "Keep a subscription's old price",
      "pack": "subscriptions",
      "runs": {
        "rule": true
      },
      "egress": [],
      "keys": [],
      "reads": [
        "recurring"
      ],
      "writes": [
        "recurring"
      ],
      "source": "/**\n * Subscriptions: keep the price a subscription had before, and the day it went up.\n *\n * STARTED WHEN A REPEATING LINE IS WRITTEN AND ITS AMOUNT, OR WHETHER IT IS A SUBSCRIPTION, CHANGES, and handed the\n * line's id. A line that is not a subscription is left alone.\n *\n * HOW IT KNOWS THE OLD PRICE. A line holds one amount, so the script keeps the last amount it saw in \"Price seen\". The\n * first time it sees a line it only notes the amount. When the amount then differs from what it saw, in the same\n * currency, it writes the old one into \"Price before\", and when the new one is higher it writes today into \"Went up\n * on\", which the Subscriptions page reads for the last ninety days. A price that went down keeps its old price and\n * clears \"Went up on\".\n *\n * IT WRITES ONLY ITS OWN THREE FIELDS, and the automation does not watch them, so it never starts itself again.\n */\n\nconst money = (m) => m && typeof m === 'object' && Number.isSafeInteger(m.amount) && typeof m.currency === 'string';\n\nexport default async function run(ctx) {\n  const id = ctx.input && ctx.input.id;\n  if (!id) return;\n  const line = await ctx.record.get(String(id));\n  if (!line || line.register !== 'recurring') return;\n  const f = line.fields;\n  if (f.subscription !== true || !money(f.amount)) return;\n  const seen = f.price_seen;\n  const name = String(f.what || 'The subscription');\n  if (!money(seen) || seen.currency !== f.amount.currency) {\n    ctx.update('recurring#' + line.seq, { price_seen: f.amount }, line.version);\n    return;\n  }\n  if (seen.amount === f.amount.amount) return;\n  const up = f.amount.amount > seen.amount;\n  ctx.update('recurring#' + line.seq, { price_seen: f.amount, price_was: seen, price_up_on: up ? ctx.today() : null }, line.version);\n  ctx.log(name + (up ? ' went up' : ' went down') + ', and its old price is kept.');\n}\n"
    },
    {
      "metric": "subs-count",
      "name": "Subscriptions",
      "pack": "subscriptions",
      "source": "register.recurring",
      "where": "state is live, subscription is true",
      "value": {
        "count": "id"
      },
      "format": "int",
      "target": {
        "gte": 0
      },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "subs-month",
      "name": "Subscriptions a month",
      "pack": "subscriptions",
      "source": "register.recurring",
      "where": "state is live, subscription is true, direction is out",
      "value": {
        "sum": {
          "product": [
            "amount",
            {
              "lookup": "per_month",
              "by": "every"
            }
          ]
        }
      },
      "lookups": {
        "per_month": {
          "weekly": 4.333333333333333,
          "fortnightly": 2.1666666666666665,
          "twice_monthly": 2,
          "monthly": 1,
          "quarterly": 0.3333333333333333,
          "yearly": 0.08333333333333333
        }
      },
      "format": "money",
      "target": {
        "gte": 0
      },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "subs-year",
      "name": "Subscriptions a year",
      "pack": "subscriptions",
      "source": "register.recurring",
      "where": "state is live, subscription is true, direction is out",
      "value": {
        "sum": {
          "product": [
            "amount",
            {
              "lookup": "per_year",
              "by": "every"
            }
          ]
        }
      },
      "lookups": {
        "per_year": {
          "weekly": 52,
          "fortnightly": 26,
          "twice_monthly": 24,
          "monthly": 12,
          "quarterly": 4,
          "yearly": 1
        }
      },
      "format": "money",
      "target": {
        "gte": 0
      },
      "window": "30d",
      "compare": "none"
    },
