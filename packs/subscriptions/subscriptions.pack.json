      "group": "money",
      "for": "both",
      "icon": "repeat",
      "block": {
        "kind": "stat",
        "heading": "Subscriptions",
        "icon": "repeat",
        "empty": "Nothing tracked yet.",
        "cells": [
          {
            "metric": "subs-month",
            "label": "A month"
          },
          {
            "metric": "subs-renew-30d",
            "label": "Renew in 30 days"
          },
          {
            "metric": "subs-unused",
            "label": "Unused"
          }
        ]
      },
      "sizes": [
        "small",
        "wide",
        "tall",
        "large"
      ],
      "size": "small",
      "needs": {
        "figures": [
          "subs-month"
        ]
      },
      "example": {
        "figures": [
          {
            "label": "A month",
            "said": "¤110"
          },
          {
            "label": "Renew in 30 days",
            "said": "4"
          }
        ]
      },
      "words": [
        "subs",
        "renewals",
        "netflix",
        "spotify"
      ],
      "asked": [
        {
          "match": "\\bsubscriptions?\\b",
          "about": "your subscriptions"
        }
      ],
      "leads": [
        "subscriptions"
      ]
    }
