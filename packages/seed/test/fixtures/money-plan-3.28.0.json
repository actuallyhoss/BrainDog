{
  "page": "money-plan",
  "title": "{{name}}",
  "for": {
    "register": "plans"
  },
  "nav": {
    "section": "Money",
    "order": 30
  },
  "icon": "calendar",
  "requires": [
    "register.plans",
    "register.installments"
  ],
  "pack": "money-core",
  "blocks": [
    {
      "kind": "note",
      "lead": true,
      "span": 12,
      "when": {
        "metric": "plan-parts:{{name}}",
        "lt": 1
      },
      "body": "No part of {{name}} is on Instalments yet. Add its parts there with {{name}} as the plan, and this page counts them."
    },
    {
      "kind": "note",
      "lead": true,
      "span": 12,
      "when": {
        "all": [
          {
            "metric": "plan-parts:{{name}}",
            "gte": 1
          },
          {
            "metric": "plan-parts-open:{{name}}",
            "gte": 1
          }
        ]
      },
      "body": "{{plan-parts-paid:{{name}}}} of {{plan-parts:{{name}}}} paid. {{plan-left:{{name}}}} left, the last part on {{plan-last-due:{{name}}}}."
    },
    {
      "kind": "note",
      "lead": true,
      "span": 12,
      "when": {
        "all": [
          {
            "metric": "plan-parts:{{name}}",
            "gte": 1
          },
          {
            "metric": "plan-parts-open:{{name}}",
            "lt": 1
          }
        ]
      },
      "body": "{{plan-parts-paid:{{name}}}} of {{plan-parts:{{name}}}} paid, and nothing is left. The last part was on {{plan-last-due:{{name}}}}."
    },
    {
      "kind": "progress",
      "heading": "Parts paid",
      "icon": "credit-card",
      "span": 12,
      "source": "register.installments",
      "where": "plan is {{name}}, state is not cancelled",
      "columns": [
        {
          "field": "plan"
        },
        {
          "field": "state"
        }
      ],
      "when": {
        "metric": "plan-parts:{{name}}",
        "gte": 1
      },
      "empty": "No part of {{name}} is on Instalments yet."
    },
    {
      "kind": "stat",
      "heading": "Paid so far",
      "icon": "wallet",
      "span": 6,
      "when": {
        "metric": "plan-parts-paid:{{name}}",
        "gt": 0
      },
      "cells": [
        {
          "metric": "plan-paid:{{name}}",
          "label": "Paid so far"
        }
      ]
    },
    {
      "kind": "stat",
      "heading": "Next part",
      "icon": "calendar-clock",
      "span": 6,
      "when": {
        "metric": "plan-next-due:{{name}}",
        "empty": false
      },
      "cells": [
        {
          "metric": "plan-next-due:{{name}}",
          "label": "Due"
        }
      ]
    },
    {
      "kind": "table",
      "heading": "Parts",
      "icon": "receipt",
      "span": 12,
      "source": "register.installments",
      "where": "plan is {{name}}",
      "columns": [
        {
          "field": "what",
          "label": "Description",
          "width": "minmax(14ch,1fr)"
        },
        {
          "field": "due",
          "label": "Due",
          "width": "13ch",
          "align": "end"
        },
        {
          "field": "amount",
          "label": "Amount",
          "width": "15ch",
          "align": "end"
        },
        {
          "field": "state",
          "label": "Status",
          "width": "11ch"
        },
        {
          "field": "paid_by",
          "label": "Paid by",
          "width": "minmax(10ch,18ch)"
        },
        {
          "field": "left_after",
          "label": "Left after",
          "width": "15ch",
          "align": "end"
        }
      ],
      "order": [
        {
          "field": "due",
          "dir": "asc"
        }
      ],
      "limit": 120,
      "empty": "No part of {{name}} is on Instalments yet."
    }
  ]
}
