    {
      "metric": "learnings-faded",
      "name": "Faded learnings",
      "source": "register.learnings",
      "where": {
        "all": [
          {
            "field": "state",
            "is": "active"
          },
          {
            "any": [
              {
                "field": "confirmed_on",
                "before": "-90d"
              },
              {
                "all": [
                  {
                    "field": "confirmed_on",
                    "empty": true
                  },
                  {
                    "field": "created_at",
                    "before": "-90d"
                  }
                ]
              }
            ]
          }
        ]
      },
      "value": {
        "count": "id"
      },
      "format": "int",
      "target": {
        "gte": 0
      },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "runs-left-next",
