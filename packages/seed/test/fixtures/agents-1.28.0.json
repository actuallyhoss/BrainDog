    {
      "page": "agents",
      "title": "Agents",
      "nav": {
        "section": "Agents",
        "order": 10,
        "place": 60
      },
      "icon": "session",
      "requires": [
        "register.session",
        "register.learnings",
        "register.skills",
        "register.tools",
        "register.credentials"
      ],
      "blocks": [
        {
          "kind": "note",
          "lead": true,
          "span": 12,
          "when": {
            "metric": "runs-working",
            "gt": 0
          },
          "body": "{{runs-working}} working, {{runs-waiting}} open and quiet, {{handoffs-open}} step(s) up next"
        },
        {
          "kind": "note",
          "lead": true,
          "span": 12,
          "when": {
            "all": [
              {
                "metric": "runs-working",
                "is": 0
              },
              {
                "metric": "runs-waiting",
                "gt": 0
              }
            ]
          },
          "body": "Nobody working right now, {{runs-waiting}} open and quiet, {{handoffs-open}} step(s) up next"
        },
        {
          "kind": "note",
          "lead": true,
          "span": 12,
          "when": {
            "all": [
              {
                "metric": "runs-working",
                "is": 0
              },
              {
                "metric": "runs-waiting",
                "is": 0
              }
            ]
          },
          "body": "Nobody working right now. {{handoffs-open}} step(s) up next"
        },
        {
          "kind": "section",
          "heading": "Tell an agent",
          "icon": "edit",
          "span": 12,
          "panel": "instruct"
        },
        {
          "kind": "section",
          "heading": "Working now",
          "icon": "session",
          "span": 12,
          "panel": "presence"
        },
        {
          "kind": "section",
          "heading": "Up next",
          "icon": "arrow",
          "span": 12,
          "panel": "left-steps"
        },
        {
          "kind": "section",
          "heading": "Recent runs",
          "icon": "clock",
          "span": 12,
          "panel": "run-list"
        },
        {
          "kind": "section",
          "key": "kept",
          "heading": "Accepted unchanged",
          "icon": "circle-check",
          "span": 12,
          "panel": "kept"
        },
        {
          "kind": "note",
          "key": "brain-link",
          "span": 12,
          "body": "[How the brain changed](/p/brain) · [Learnings](/r/learnings) · [Skills](/r/skills) · [Tools](/r/tools) · [Keys](/r/credentials)"
        },
        {
          "kind": "note",
          "tone": "warn",
          "span": 12,
          "when": {
            "metric": "keys-nowhere",
            "is": 1
          },
          "body": "1 key has no value. [Add it in the Keychain](/keychain)"
        },
        {
          "kind": "note",
          "tone": "warn",
          "span": 12,
          "when": {
            "metric": "keys-nowhere",
            "gt": 1
          },
          "body": "{{keys-nowhere}} keys have no value. [Add them in the Keychain](/keychain)"
        },
        {
          "kind": "note",
          "tone": "warn",
          "span": 12,
          "when": {
            "metric": "keys-expired",
            "is": 1
          },
          "body": "1 key is past its day. Renew or retire it."
        },
        {
          "kind": "note",
          "tone": "warn",
          "span": 12,
          "when": {
            "metric": "keys-expired",
            "gt": 1
          },
          "body": "{{keys-expired}} keys are past their day. Renew or retire each."
        },
        {
          "kind": "note",
          "tone": "warn",
          "span": 12,
          "when": {
            "metric": "tools-unseen",
            "gt": 0
          },
          "body": "{{tools-unseen}} tool(s) not used for a month. Retire any you no longer need."
        },
        {
          "kind": "note",
          "tone": "warn",
          "span": 12,
          "when": {
            "metric": "keys-in-text",
            "is": 1
          },
          "body": "A key is written in plain text in 1 place. Move it to the Keychain."
        },
        {
          "kind": "note",
          "tone": "warn",
          "span": 12,
          "when": {
            "metric": "keys-in-text",
            "gt": 1
          },
          "body": "Keys are written in plain text in {{keys-in-text}} places. Move each to the Keychain."
        }
      ]
    },
    {
      "page": "skill",
      "title": "{{name}}",
      "for": {
        "register": "skills",
        "where": "state is active"
      },
      "icon": "skill",
      "requires": [
        "register.skills",
        "register.learnings"
      ],
      "blocks": [
        {
          "kind": "note",
          "lead": true,
          "span": 12,
          "body": "{{trigger}}"
        },
        {
          "kind": "diff",
          "heading": "Versions",
          "icon": "history",
          "span": 12,
          "source": "register.skills",
          "row": "{{spoken}}",
          "field": "body",
          "versions": 5,
          "empty": "One version so far."
        },
        {
          "kind": "cards",
          "heading": "Learnings behind this version",
          "icon": "learning",
          "span": 12,
          "source": "register.learnings",
          "where": "id is {{because}}",
          "columns": [
            {
              "field": "lesson",
              "as": "title"
            },
            {
              "field": "confirmed_on",
              "as": "when"
            }
          ],
          "limit": 8
        },
        {
          "kind": "cards",
          "heading": "Learnings that bear on it",
          "icon": "lightbulb",
          "span": 12,
          "source": "register.learnings",
          "where": "topic is {{name}}, state is active",
          "columns": [
            {
              "field": "lesson",
              "as": "title"
            },
            {
              "field": "kind",
              "label": "Kind",
              "as": "fact"
            },
            {
              "field": "project",
              "label": "Where it applies",
              "as": "scope"
            },
            {
              "field": "confirmed_on",
              "as": "when"
            }
          ],
          "order": [
            {
              "field": "seq",
              "dir": "desc"
            }
          ],
          "limit": 8,
          "when": {
            "metric": "skill-learnings:{{name}}",
            "gt": 0
          }
        }
      ]
    },
    {
      "page": "brain",
      "title": "How the brain changed",
      "icon": "learning",
      "requires": [
        "register.learnings"
      ],
      "blocks": [
        {
          "kind": "note",
          "key": "line",
          "lead": true,
          "span": 12,
          "when": {
            "metric": "learnings-arrived",
            "gt": 0
          },
          "body": "{{learnings-arrived}} learning(s) arrived this month, {{learnings-active}} in use in all, {{skills-changed}} skill(s) changed, {{learnings-faded}} faded"
        },
        {
          "kind": "note",
          "key": "line-quiet",
          "lead": true,
          "span": 12,
          "when": {
            "metric": "learnings-arrived",
            "is": 0
          },
          "body": "Nothing new this month, {{learnings-active}} learning(s) in use in all, {{skills-changed}} skill(s) changed, {{learnings-faded}} faded"
        },
        {
          "kind": "series",
          "key": "by-week",
          "heading": "Learnings that arrived and skills that changed, by week",
          "icon": "chart-column",
          "span": 12,
          "series": [
            {
              "metric": "learnings-by-week",
              "label": "Learnings"
            },
            {
              "metric": "skills-changed-by-week",
              "label": "Skills changed"
            }
          ],
          "back": 24,
          "when": {
            "metric": "learnings-charted",
            "gt": 0
          }
        },
        {
          "kind": "cards",
          "key": "changed",
          "heading": "What changed",
          "icon": "history",
          "span": 12,
          "source": "register.learnings",
          "columns": [
            {
              "field": "lesson",
              "as": "title"
            },
            {
              "field": "topic",
              "label": "Bears on",
              "as": "fact"
            },
            {
              "field": "supersedes",
              "label": "Replaces",
              "as": "fact"
            },
            {
              "field": "confirmed_on",
              "label": "Last confirmed",
              "as": "when"
            }
          ],
          "order": [
            {
              "field": "created_at",
              "dir": "desc"
            }
          ],
          "limit": 12
        },
        {
          "kind": "section",
          "key": "timeline",
          "heading": "Over time",
          "icon": "history",
          "span": 12,
          "panel": "evolution"
        },
        {
          "kind": "section",
          "key": "faded",
          "heading": "Faded",
          "icon": "clock",
          "span": 12,
          "source": "register.learnings",
          "where": {
            "all": [
              {
                "field": "state",
                "is": "active"
              },
              {
                "any": [
                  {
                    "field": "confirmed_on",
                    "before": "-90d"
                  },
                  {
                    "all": [
                      {
                        "field": "confirmed_on",
                        "empty": true
                      },
                      {
                        "field": "created_at",
                        "before": "-90d"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "limit": 1,
          "when": {
            "metric": "learnings-faded",
            "gt": 0
          }
        },
        {
          "kind": "cards",
          "key": "faded-learnings",
          "span": 12,
          "source": "register.learnings",
          "where": {
            "all": [
              {
                "field": "state",
                "is": "active"
              },
              {
                "any": [
                  {
                    "field": "confirmed_on",
                    "before": "-90d"
                  },
                  {
                    "all": [
                      {
                        "field": "confirmed_on",
                        "empty": true
                      },
                      {
                        "field": "created_at",
                        "before": "-90d"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "columns": [
            {
              "field": "lesson",
              "as": "title"
            },
            {
              "field": "confirmed_on",
              "label": "Last confirmed",
              "as": "when"
            }
          ],
          "order": [
            {
              "field": "created_at",
              "dir": "asc"
            }
          ],
          "limit": 12,
          "when": {
            "metric": "learnings-faded",
            "gt": 0
          }
        }
      ]
    },
    {
      "page": "run",
      "title": "{{doing}}",
      "for": {
        "register": "session"
      },
      "icon": "session",
      "requires": [
        "register.session"
      ],
      "blocks": [
        {
          "kind": "section",
          "heading": "What it did",
          "icon": "history",
          "span": 12,
          "panel": "run"
        }
      ]
    }
  ]
}
