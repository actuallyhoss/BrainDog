{
  "pack": "agents",
  "version": "1.28.0",
  "summary": "What your agents learn, the skills they use, the keys they are handed and the tools they run.",
  "author": "BrainDog",
  "license": "MIT",
  "requires": {
    "format": 1,
    "primitives": 1,
    "packs": {}
  },
  "declarations": [
    {
      "register": "learnings",
      "name": "Learnings",
      "one": "learning",
      "icon": "learning",
      "pack": "agents",
      "role": "learnings",
      "fade": {
        "field": "confirmed_on",
        "after": "90d"
      },
      "seq_prefix": "LN",
      "holds": "what an agent found out the hard way, with the failure that taught it. Record one only when it changes what a session does, holds beyond this one case, a session without it would get something wrong, and it has no other home",
      "title": "lesson",
      "state": "state",
      "done": [
        "superseded",
        "reverted"
      ],
      "same": {
        "fields": [
          "lesson"
        ],
        "within": "project",
        "fold": "text"
      },
      "mobile": [
        "lesson",
        "kind",
        "topic"
      ],
      "fields": [
        {
          "id": "lesson",
          "label": "Lesson",
          "type": "text",
          "required": true,
          "min": 12,
          "max": 400,
          "search": true
        },
        {
          "id": "because",
          "label": "Because",
          "type": "text",
          "required": true,
          "min": 24,
          "max": 600,
          "search": true
        },
        {
          "id": "kind",
          "label": "Kind",
          "type": "enum",
          "values": [
            "method",
            "fact",
            "rule"
          ],
          "labels": {
            "rule": "Rule"
          },
          "required": true,
          "index": true
        },
        {
          "id": "project",
          "label": "Where it applies",
          "type": "ref",
          "to": "things",
          "index": true,
          "scope": {
            "widen": "person"
          }
        },
        {
          "id": "topic",
          "label": "Skill or topic it bears on",
          "type": "text",
          "index": true
        },
        {
          "id": "confirmed_on",
          "label": "Last confirmed",
          "type": "day",
          "index": true
        },
        {
          "id": "supersedes",
          "label": "Replaces",
          "type": "ref",
          "to": "learnings"
        },
        {
          "id": "state",
          "label": "Status",
          "type": "enum",
          "values": [
            "active",
            "superseded",
            "reverted"
          ],
          "default": "active",
          "required": true,
          "index": true,
          "transitions": {
            "active": {
              "to": [
                "superseded",
                "reverted"
              ],
              "requires": [
                "why"
              ]
            },
            "superseded": {
              "to": [
                "active"
              ],
              "by": "decide"
            },
            "reverted": {
              "to": [
                "active"
              ],
              "by": "decide"
            }
          }
        },
        {
          "id": "why",
          "label": "Why it changed",
          "type": "text",
          "min": 24
        },
        {
          "id": "tags",
          "type": "list",
          "of": "text"
        }
      ]
    },
    {
      "register": "skills",
      "name": "Skills",
      "one": "skill",
      "icon": "skill",
      "pack": "agents",
      "role": "skills",
      "holds": "what a session can do here, the moment to reach for it, and its text, versioned",
      "title": "name",
      "state": "state",
      "done": [
        "retired"
      ],
      "same": {
        "fields": [
          "name"
        ],
        "within": "project",
        "fold": "exact"
      },
      "mobile": [
        "name",
        "trigger",
        "rev",
        "because"
      ],
      "fields": [
        {
          "id": "name",
          "label": "Name",
          "type": "text",
          "required": true,
          "max": 64,
          "index": true,
          "search": true
        },
        {
          "id": "trigger",
          "label": "When to use it",
          "type": "text",
          "required": true,
          "max": 400,
          "search": true
        },
        {
          "id": "what",
          "label": "What it is",
          "type": "text",
          "max": 400
        },
        {
          "id": "kind",
          "label": "Kind",
          "type": "enum",
          "values": [
            "skill",
            "command"
          ],
          "default": "skill",
          "required": true,
          "index": true
        },
        {
          "id": "project",
          "label": "Where it applies",
          "type": "ref",
          "to": "things",
          "index": true,
          "scope": {
            "widen": "person",
            "same": "nearer"
          }
        },
        {
          "id": "body",
          "label": "Text",
          "type": "document",
          "required": true,
          "by": "decide"
        },
        {
          "id": "rev",
          "label": "Version",
          "type": "int",
          "default": 1,
          "required": true,
          "by": "decide"
        },
        {
          "id": "managed",
          "label": "Written by the record",
          "type": "bool",
          "default": true
        },
        {
          "id": "source",
          "label": "Source",
          "type": "url"
        },
        {
          "id": "because",
          "label": "Learnings behind it",
          "type": "list",
          "of": "ref",
          "to": "learnings"
        },
        {
          "id": "state",
          "label": "Status",
          "type": "enum",
          "values": [
            "active",
            "retired"
          ],
          "default": "active",
          "required": true,
          "index": true
        },
        {
          "id": "tags",
          "type": "list",
          "of": "text"
        }
      ]
    },
    {
      "register": "credentials",
      "name": "Keys",
      "one": "key",
      "icon": "key",
      "pack": "agents",
      "role": "keys-index",
      "holds": "what each key opens and where it applies; the key itself is sealed in the Keychain or kept somewhere named",
      "title": "label",
      "state": "state",
      "done": [
        "retired"
      ],
      "same": {
        "fields": [
          "label"
        ],
        "within": "project",
        "fold": "text",
        "keep": "sealed"
      },
      "mobile": [
        "label",
        "opens",
        "project"
      ],
      "fields": [
        {
          "id": "label",
          "label": "Name",
          "type": "text",
          "required": true,
          "max": 120,
          "search": true
        },
        {
          "id": "opens",
          "label": "What it opens",
          "type": "text",
          "required": true,
          "max": 280,
          "search": true
        },
        {
          "id": "provider",
          "label": "Provider",
          "type": "text",
          "index": true,
          "search": true
        },
        {
          "id": "account",
          "label": "Account",
          "type": "text",
          "max": 280,
          "search": true
        },
        {
          "id": "kind",
          "label": "Kind",
          "type": "enum",
          "values": [
            "api_token",
            "password",
            "ssh_key",
            "recovery_codes",
            "note"
          ],
          "required": true,
          "index": true
        },
        {
          "id": "project",
          "label": "Where it applies",
          "type": "ref",
          "to": "things",
          "index": true,
          "scope": {
            "widen": "person"
          }
        },
        {
          "id": "value",
          "label": "Locked value",
          "type": "secret"
        },
        {
          "id": "where",
          "label": "Kept at",
          "type": "text",
          "max": 280
        },
        {
          "id": "origin",
          "label": "Came from",
          "type": "text",
          "max": 280
        },
        {
          "id": "note",
          "label": "Note",
          "type": "text"
        },
        {
          "id": "verified",
          "label": "Last known to work",
          "type": "day"
        },
        {
          "id": "expires",
          "label": "Expires",
          "type": "day",
          "deadline": true,
          "remind": [
            "-14d",
            "-2d"
          ]
        },
        {
          "id": "state",
          "label": "Status",
          "type": "enum",
          "values": [
            "live",
            "stale",
            "invalid",
            "missing",
            "retired"
          ],
          "default": "live",
          "required": true,
          "index": true
        },
        {
          "id": "tags",
          "type": "list",
          "of": "text"
        }
      ]
    },
    {
      "register": "tools",
      "name": "Tools",
      "one": "tool",
      "icon": "plug",
      "pack": "agents",
      "role": "tools",
      "holds": "every MCP server, command line and integration an agent uses, how it starts, and the keys it needs by name",
      "title": "name",
      "state": "state",
      "done": [
        "retired"
      ],
      "same": {
        "fields": [
          "name"
        ],
        "within": "project",
        "fold": "text"
      },
      "mobile": [
        "name",
        "kind",
        "project"
      ],
      "fields": [
        {
          "id": "name",
          "label": "Name",
          "type": "text",
          "required": true,
          "max": 64,
          "index": true,
          "search": true
        },
        {
          "id": "kind",
          "label": "Kind",
          "type": "enum",
          "values": [
            "mcp",
            "cli",
            "integration"
          ],
          "labels": {
            "mcp": "MCP server",
            "cli": "Command line",
            "integration": "Integration"
          },
          "required": true,
          "index": true
        },
        {
          "id": "transport",
          "label": "How it runs",
          "type": "enum",
          "values": [
            "stdio",
            "http"
          ],
          "labels": {
            "stdio": "Runs on your machine",
            "http": "Reached over the web"
          },
          "required_when": {
            "field": "kind",
            "is": "mcp"
          }
        },
        {
          "id": "command",
          "label": "Command",
          "type": "text",
          "max": 512,
          "required_when": {
            "field": "transport",
            "is": "stdio"
          }
        },
        {
          "id": "args",
          "label": "Arguments",
          "type": "list",
          "of": "text"
        },
        {
          "id": "endpoint",
          "label": "Address",
          "type": "text",
          "max": 512,
          "required_when": {
            "field": "transport",
            "is": "http"
          }
        },
        {
          "id": "needs",
          "label": "Keys it needs",
          "type": "list",
          "of": "text"
        },
        {
          "id": "trigger",
          "label": "When to use it",
          "type": "text",
          "max": 400,
          "search": true
        },
        {
          "id": "project",
          "label": "Where it applies",
          "type": "ref",
          "to": "things",
          "index": true,
          "scope": {
            "widen": "person",
            "same": "nearer"
          }
        },
        {
          "id": "hosts",
          "label": "Seen on",
          "type": "list",
          "of": "text"
        },
        {
          "id": "seen",
          "label": "Last seen",
          "type": "instant",
          "index": true
        },
        {
          "id": "origin",
          "label": "Came from",
          "type": "text",
          "max": 280
        },
        {
          "id": "state",
          "label": "Status",
          "type": "enum",
          "values": [
            "active",
            "stale",
            "invalid",
            "retired"
          ],
          "default": "active",
          "required": true,
          "index": true
        },
        {
          "id": "tags",
          "type": "list",
          "of": "text"
        }
      ]
    },
    {
      "metric": "learnings-by-week",
      "name": "Learnings added, by week",
      "source": "register.learnings",
      "where": "created_at after -182d",
      "value": {
        "count": "id"
      },
      "group_by": "created_at",
      "bucket": "week",
      "format": "int",
      "target": {
        "gte": 0
      },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "keys-by-week",
      "name": "Keys added, by week",
      "source": "register.credentials",
      "where": "created_at after -182d",
      "value": {
        "count": "id"
      },
      "group_by": "created_at",
      "bucket": "week",
      "format": "int",
      "target": {
        "gte": 0
      },
      "window": "30d",
      "compare": "none"
    },
    {
      "metric": "tools-by-week",
