{
  "name": "braindog-render",
  "version": "0.1.0",
  "description": "The BrainDog block dialect: a parser, forty kinds over eight primitives, and two renderers held to one accessibility tree.",
  "type": "module",
  "sideEffects": ["**/*.svelte"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/actuallyhoss/BrainDog.git", "directory": "packages/render" },
  "exports": {
    ".": "./src/index.ts",
    "./svelte": "./svelte/index.ts",
    "./glyphs": "./src/glyphs/index.ts",
    "./glyphs/names": "./src/glyphs/names.ts",
    "./widget-compose": "./src/widget-compose.ts",
    "./kinds-for": "./src/kinds-for.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./glyphs": { "types": "./dist/glyphs/index.d.ts", "default": "./dist/glyphs/index.js" },
      "./glyphs/names": { "types": "./dist/glyphs/names.d.ts", "default": "./dist/glyphs/names.js" }
    }
  },
  "files": ["dist", "src/glyphs/NOTICE"],
  "peerDependencies": {
    "svelte": "^5"
  },
  "peerDependenciesMeta": {
    "svelte": { "optional": true }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "test": "node --test src/*.test.ts src/glyphs/*.test.ts svelte/p/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  }
}
